---
// Astro returns BASE_URL without a trailing slash at the root but with one
// under a subpath; normalise so `${base}x` is never `/cyber-cvx`.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Disclosure from '../components/Disclosure.astro';
import { teamBrainSystem, factoriumSystem, shots } from '../data/systems';
import { teamBrain } from '../data/team-brain';
---
<Base
  title="Systems — Michal Malček"
  description="Two AI systems, the apparatus around them, what went wrong, and the code that is public."
  back={{ href: `${base}`, label: 'Back to overview' }}
>
  <header class="pt-10 pb-8 border-b border-line">
    <div class="eyebrow mb-3">What was built</div>
    <h1 class="text-[clamp(28px,4vw,40px)] font-semibold tracking-tight m-0 mb-3">
      <span class="glow-name">Systems</span>
    </h1>
    <p class="text-fg-dim max-w-[680px] m-0">
      One production system delivered and handed over, one running daily, the apparatus that grew
      around them, and the failures that shaped both. Every figure on this page comes from a store
      or a git history rather than from memory.
    </p>
  </header>

  <!-- ── Team Brain ───────────────────────────────────────────────────── -->
  <Section id="team-brain" title="Team Brain" note="built · deployed · handed over">
    <p class="text-fg-dim max-w-[720px] mt-0 mb-5">
      {teamBrainSystem.tagline}. Fifteen people, five live data sources, one 8&nbsp;GB VPS —
      a textbook Anthropic SDK deployment where the interesting part is the cost and routing
      discipline, not the model.
    </p>

    <!-- Measured, from the production database at handover. -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-3">
      {[[teamBrainSystem.measured.toolSuccessPct + '%', 'tool success over 1,352 real calls'],
        [teamBrainSystem.measured.users, 'daily users, none of them engineers'],
        [(teamBrainSystem.measured.tokensIn / 1_000_000).toFixed(1) + 'M', 'input tokens, Feb–Jun'],
        ['$30', 'Claude API per month']].map(([v, l]) => (
        <div class="card p-4">
          <div class="text-[22px] font-semibold lit-forge leading-none tabular-nums">{v}</div>
          <div class="text-[11.5px] text-fg-ghost mt-1.5 leading-snug">{l}</div>
        </div>
      ))}
    </div>

    <div class="grid md:grid-cols-2 gap-3 mb-3">
      <!-- The stack, by layer. -->
      <div class="card p-5">
        <div class="eyebrow mb-3">Stack, by layer</div>
        <dl class="m-0 flex flex-col gap-1.5">
          {teamBrainSystem.stackLayers.map(([layer, tech]) => (
            <div class="grid grid-cols-[92px_1fr] gap-3 items-baseline text-[13px]">
              <dt class="text-synapse shrink-0">{layer}</dt>
              <dd class="text-fg-dim m-0">{tech}</dd>
            </div>
          ))}
        </dl>
      </div>

      <!-- Five sources joined behind one query surface. -->
      <div class="card p-5">
        <div class="eyebrow mb-3">Five sources, one query surface</div>
        <dl class="m-0 flex flex-col gap-2">
          {teamBrainSystem.sources.map(([name, detail]) => (
            <div>
              <dt class="text-[13px] text-forge font-semibold">{name}</dt>
              <dd class="text-[12.5px] text-fg-dim m-0">{detail}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>

    <!-- Agents: six specialists, model per role. -->
    <div class="card p-5 mb-3">
      <div class="eyebrow mb-3">Six specialists, model chosen per role</div>
      <div class="flex flex-col gap-1">
        {teamBrainSystem.agents.map(([name, model, role]) => (
          <div class="grid grid-cols-[84px_1fr] sm:grid-cols-[84px_96px_1fr] gap-x-3 gap-y-0.5
                      py-1.5 border-b border-line/40 last:border-b-0 text-[13px] items-baseline">
            <b class="text-fg">{name}</b>
            <code class="text-synapse text-[12px]">{model}</code>
            <span class="text-fg-dim col-span-2 sm:col-span-1">{role}</span>
          </div>
        ))}
      </div>
      <p class="text-[12.5px] text-fg-ghost mt-3 mb-0" set:html={teamBrainSystem.agentNote} />
    </div>

    <div class="grid md:grid-cols-2 gap-3 mb-3">
      <div class="card p-5">
        <div class="eyebrow mb-3">Routing — five signals, in order</div>
        <ol class="list-none p-0 m-0 flex flex-col gap-1.5">
          {teamBrainSystem.routing.map((r, i) => (
            <li class="flex gap-3 text-[13px] text-fg-dim">
              <span class="lit-cyan text-[12px] font-semibold shrink-0 w-3">{i + 1}</span>{r}
            </li>
          ))}
        </ol>
        <p class="text-[12px] text-fg-ghost mt-3 mb-0">
          Deterministic, not a model guessing which agent to be.
        </p>
      </div>
      <div class="card p-5">
        <div class="eyebrow mb-3">Four chat modes</div>
        <dl class="m-0 flex flex-col gap-1.5">
          {teamBrainSystem.modes.map(([m, d]) => (
            <div class="grid grid-cols-[76px_1fr] gap-3 items-baseline text-[13px]">
              <dt class="text-forge">{m}</dt>
              <dd class="text-fg-dim m-0">{d}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>

    <!-- Autonomous jobs. -->
    <div class="card p-5 mb-3">
      <div class="eyebrow mb-3">Night shift — nine autonomous jobs on cron</div>
      <dl class="m-0 grid sm:grid-cols-2 gap-x-5 gap-y-1.5">
        {teamBrainSystem.nightShift.map(([when, what]) => (
          <div class="grid grid-cols-[112px_1fr] gap-3 items-baseline text-[13px]">
            <dt class="text-synapse shrink-0">{when}</dt>
            <dd class="text-fg-dim m-0">{what}</dd>
          </div>
        ))}
      </dl>
    </div>

    <!-- Cost, derived rather than claimed. -->
    <div class="card p-5 mb-3">
      <div class="eyebrow mb-2">What it cost to run</div>
      <p class="text-[13.5px] text-fg-dim m-0" set:html={teamBrainSystem.costNote} />
    </div>

    <div class="card p-5 mb-3">
      <div class="eyebrow mb-3">Decisions worth defending</div>
      <div class="flex flex-col gap-2.5">
        {teamBrainSystem.decisions.map((d) => (
          <div class="border-l-2 border-neural/35 pl-3">
            <b class="text-[13.5px] text-fg block">{d.head}</b>
            <p class="text-[13px] text-fg-dim m-0 mt-0.5">{d.body}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="card p-5 mb-4">
      <div class="eyebrow mb-2">Handover</div>
      <p class="text-[13.5px] text-fg-dim m-0" set:html={teamBrainSystem.handover} />
    </div>


    <!-- Gallery. -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-2.5 mb-4">
      {shots.teamBrain.map(([file, caption]) => (
        <figure class="m-0 card overflow-hidden group">
          <img src={`${base}shots/${file}`} alt={caption} loading="lazy" width="1600" height="1000"
               class="w-full h-auto block transition-transform duration-500 group-hover:scale-[1.03]" />
          <figcaption class="text-[11.5px] text-fg-ghost px-3 py-2">{caption}</figcaption>
        </figure>
      ))}
    </div>

    <div class="flex flex-wrap gap-2">
      {teamBrainSystem.stack.map((t) => <span class="chip">{t}</span>)}
    </div>
  </Section>
  <Section id="factorium" title="Factorium" note="running daily · pre-release">
    <p class="text-fg-dim max-w-[730px] mt-0 mb-3">{factoriumSystem.premise}</p>

    <div class="grid md:grid-cols-2 gap-3 mb-3">
      <div class="card p-5 border-synapse/25">
        <div class="eyebrow mb-2">Where v01 stands</div>
        <p class="text-[13.5px] text-fg-dim m-0">
          <b class="text-fg">The compile gate is not the blocker.</b> Build passes at 2,911
          modules, tsc clean, 23 of 23 smoke tests, nine apps in place. What remains is UI
          tuning and one untested button — not architecture.
        </p>
      </div>
      <div class="card p-5">
        <div class="eyebrow mb-2">What it is for</div>
        <p class="text-[13.5px] text-fg-dim m-0">{factoriumSystem.ambition}</p>
      </div>
    </div>

    <div class="card p-5 mb-3">
      <div class="eyebrow mb-3">{factoriumSystem.architecture.lead}</div>
      <div class="grid grid-cols-3 sm:grid-cols-6 gap-3 mb-4">
        {factoriumSystem.architecture.counts.map(([v, l]) => (
          <div>
            <div class="text-[19px] font-semibold lit-forge leading-none tabular-nums">{v}</div>
            <div class="text-[11px] text-fg-ghost mt-1 leading-snug">{l}</div>
          </div>
        ))}
      </div>
      <dl class="m-0 flex flex-col gap-2.5">
        {factoriumSystem.architecture.layers.map(([name, detail]) => (
          <div class="grid grid-cols-1 sm:grid-cols-[112px_1fr] gap-x-4 gap-y-0.5 items-baseline">
            <dt class="text-[13px] text-synapse font-semibold">{name}</dt>
            <dd class="text-[13px] text-fg-dim m-0">{detail}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="grid md:grid-cols-2 gap-3 mb-3">
      <div class="card p-5">
        <div class="eyebrow mb-3">Nine apps</div>
        <dl class="m-0 flex flex-col gap-1.5">
          {factoriumSystem.apps.map(([name, what]) => (
            <div>
              <dt class="text-[12.5px] text-forge font-semibold">{name}</dt>
              <dd class="text-[12.5px] text-fg-dim m-0">{what}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="card p-5">
        <div class="eyebrow mb-3">What the local agent can do</div>
        <ul class="list-none p-0 m-0 flex flex-col gap-1.5">
          {factoriumSystem.agentCan.map((c) => (
            <li class="flex gap-2.5 text-[12.5px] text-fg-dim">
              <span class="text-synapse shrink-0">·</span>{c}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Models: one in production, two on the bench. -->
    <div class="card p-5 mb-3">
      <div class="eyebrow mb-3">{factoriumSystem.models.lead}</div>
      <div class="border-l-2 border-synapse/50 pl-3 mb-3">
        <b class="text-[13.5px] text-fg block">In production · {factoriumSystem.models.production.id}</b>
        <p class="text-[13px] text-fg-dim m-0 mt-0.5">{factoriumSystem.models.production.why}</p>
      </div>
      <div class="flex flex-col gap-1.5 mb-3">
        {factoriumSystem.models.bench.map(([id, note]) => (
          <div class="grid grid-cols-1 sm:grid-cols-[188px_1fr] gap-x-3 text-[12.5px] items-baseline">
            <b class="text-fg-dim">{id}</b>
            <span class="text-fg-ghost">{note}</span>
          </div>
        ))}
      </div>
      <p class="text-[12.5px] text-fg-ghost m-0 mb-2">{factoriumSystem.models.constraint}</p>
      <p class="text-[12.5px] text-fg-ghost m-0" set:html={factoriumSystem.models.quantisation} />
    </div>

    <div class="card p-5 mb-3">
      <div class="eyebrow mb-2">Open source at release</div>
      <p class="text-[13.5px] text-fg-dim m-0">{factoriumSystem.openSource}</p>
    </div>

    <!-- Gallery. -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-2.5 mb-4">
      {shots.factorium.map(([file, caption]) => (
        <figure class="m-0 card overflow-hidden group">
          <img src={`${base}shots/${file}`} alt={caption} loading="lazy" width="1600" height="1000"
               class="w-full h-auto block transition-transform duration-500 group-hover:scale-[1.03]" />
          <figcaption class="text-[11.5px] text-fg-ghost px-3 py-2">{caption}</figcaption>
        </figure>
      ))}
    </div>

    <div class="flex flex-wrap gap-2">
      {factoriumSystem.stack.map((t) => <span class="chip">{t}</span>)}
    </div>
  </Section>

  <!-- ── What was tried, and what it cost ─────────────────────────────────
       One section, not two. Each row is a decision or a defect with the
       measurement that settled it; the full accounts are in the papers. -->
  <Section
    id="wrong"
    title="What was tried, and what it cost"
    note="the useful part"
    lede="Limits first: one machine, roughly six months, no team, no budget. Everything below is a stored measurement, and all of it was found the same way — by checking a thing whose answer was already known."
  >
    <div class="flex flex-col gap-2.5">
      {[
        ['Parallel agents and heavy orchestration', 'removed',
         'Tried in both directions — multi-agent orchestration, parallel runs, elaborate harnesses, several configurations. What survived is one cloud model, one local model, one shared store, a hand-written runtime. On 24 GB every added layer competes for the same memory, and every added abstraction removes a place to look when something breaks.'],
        ['No agent framework', 'held since May',
         'Own runtime; the vendor SDK only for the cloud model. A framework injects prompt content you did not write, which is fatal when the thing being measured is how a 12B model responds to instructions. The same logic kept Zod out of 22 tool modules — a hand-written validator rejected 5 of 5 probes — and put it in the one place where the input is a file from disk we do not control.'],
        ['An embedding model used outside its contract', 'weeks',
         'nomic-embed requires asymmetric prefixes; served through llama.cpp nothing adds them, so short irrelevant text outranked long relevant text and nothing errored. 10,676 records re-embedded — and the first repair script read only the body field while the writer had embedded title + body, which would have silently stripped titles from 95% of vectors.'],
        ['The failures were almost never in the model', 'three days',
         'Spent on retrieval quality before the actual defect surfaced: the answer was not in the index. 58% of one collection were duplicates of a single turn, and the local model\'s own conversations had never been indexed at all.'],
        ['Silent failure as a class, not a bug', 'nine found in one sweep',
         'Input accepted, matched against nothing, discarded, operation reports success. A validator that skipped unknown keys meant every optional-parameter typo the local model made was ignored. Five mutations — including a token revoke — treated a non-2xx as a rejection rather than a failure.'],
        ['A speech-to-text stage that should never have been added', 'a week',
         'Whisper was wired in before testing whether the model could take audio directly. It could. Removing it restored acoustic nuance the model actually uses.'],
        ['What the measurement said about the model, not the code', 'the finding',
         'Rules retrieved by their own wording: 1 in 5. Stored as the situations that trigger them: 10 in 10. Asked afterwards which of its rules carried real information, the model misclassified 7 of 8 — including three that had changed its decision minutes earlier. Value is measured by behaviour, never by asking.'],
      ].map(([head, cost, body]) => (
        <div class="card p-5">
          <div class="flex items-baseline justify-between gap-3 flex-wrap mb-1.5">
            <b class="text-[14.5px] text-fg leading-snug">{head}</b>
            <span class="text-[11px] uppercase tracking-wider text-forge border border-forge/35 rounded px-1.5 py-0.5 shrink-0">{cost}</span>
          </div>
          <p class="text-[13.5px] text-fg-dim m-0">{body}</p>
        </div>
      ))}
    </div>
  </Section>
  <Section
    id="games"
    title="Games that teach a value system"
    note="three prototypes"
    lede="One idea, three attempts: a scoring rule that teaches a value system rather than a skill. Aimed at learning — children included — which is why none of them can be finished."
  >
    <div class="card p-5 mb-3">
      <div class="flex flex-wrap items-baseline gap-3 mb-2">
        <b class="text-[16.5px] text-fg font-semibold">MPC arcade</b>
        <code class="text-[12.5px] text-synapse">mpcmcp</code>
        <span class="text-[11.5px] text-fg-ghost">inside Factorium · not open source yet</span>
      </div>
      <p class="text-[14px] text-fg-dim mt-0 mb-3">
        While flying the 3D knowledge graph, typing <code class="text-synapse">mpcmcp</code> wakes a
        shooter. The crystals use the same shape-language as the graph nodes, and the scoring is
        inverted on purpose.
      </p>
      <div class="grid sm:grid-cols-2 gap-3 mb-3">
        <div class="border-l-2 border-forge/50 pl-3">
          <b class="text-[13.5px] text-forge block mb-1">Daemons — shoot them, +score</b>
          <p class="text-[13px] text-fg-dim m-0">
            The opposites of the system's values and its bad habits: sycophancy, skipping
            verification, treating the model as a calculator, giving up, entropy. Popping one
            lands as having actually got rid of a bad habit.
          </p>
        </div>
        <div class="border-l-2 border-synapse/50 pl-3">
          <b class="text-[13.5px] text-synapse block mb-1">Angels — avoid them, −score</b>
          <p class="text-[13px] text-fg-dim m-0">
            The real values, pulled <b class="text-fg">live from the hive's own lexicon</b>, so the
            game always speaks the current Codex. Hit "Primacy of Truth" or "stop-and-ask" and it
            costs you. The supreme axiom never spawns at all.
          </p>
        </div>
      </div>
      <div class="flex flex-wrap gap-2">
        {[['MPC arcade — part 1', 'https://www.youtube.com/watch?v=1Rzro-dXMqk'],
          ['MPC arcade — part 2', 'https://www.youtube.com/watch?v=gi6WXwvcjPo']].map(([t, u]) => (
          <a href={u} target="_blank" rel="noopener"
             class="inline-flex items-center gap-2 text-[12.5px] text-forge no-underline
                    border border-forge/30 rounded-lg px-2.5 py-1.5 hover:bg-forge/10">
            <svg width="10" height="12" viewBox="0 0 9 11" fill="currentColor" aria-hidden="true"><path d="M0 0.5L9 5.5L0 10.5V0.5Z" /></svg>
            {t}
          </a>
        ))}
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-3">
      <div class="card p-5">
        <div class="flex flex-wrap items-baseline gap-3 mb-2">
          <b class="text-[15.5px] text-fg font-semibold">cybernetic-genesis</b>
          <a href="https://misomalcek.github.io/cybernetic-genesis/" target="_blank" rel="noopener"
             class="text-[12px] text-forge border border-forge/40 rounded px-2 py-0.5 no-underline">play →</a>
          <a href="https://github.com/misomalcek/cybernetic-genesis" target="_blank" rel="noopener"
             class="text-[12px] text-synapse no-underline hover:underline">source →</a>
        </div>
        <p class="text-[13.5px] text-fg-dim m-0">
          Two canvas games, plain HTML and vanilla JS. In <i>Entropy Harvest</i> the combo grows
          while you keep clearing — the mechanic rewards sustained order rather than one good move.
        </p>
      </div>
      <div class="card p-5">
        <div class="flex flex-wrap items-baseline gap-3 mb-2">
          <b class="text-[15.5px] text-fg font-semibold">neon-shift</b>
          <a href="https://github.com/misomalcek/neon-shift" target="_blank" rel="noopener"
             class="text-[12px] text-synapse no-underline hover:underline">source →</a>
        </div>
        <p class="text-[13.5px] text-fg-dim m-0">
          A playable prototype generated from a single sentence, spending an entire free tier in
          one sitting. A test of how far one prompt goes with an agent that writes and deploys.
        </p>
      </div>
    </div>
  </Section>
</Base>
