---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import { academic, lineageRepos, repos, games } from '../../data/public-work';
---
<Base
  title="Publication — Michal Malček"
  description="alteranai.com, aisvet.sk, channels, SUNO, research notebooks, and the academic profile."
  back={{ href: base, label: 'Back to CV' }}
>
  <header class="pt-10 pb-8 border-b border-line">
    <h1 class="text-[clamp(35px,4.8vw,52px)] font-semibold tracking-tight m-0 mb-3">Publication</h1>
    <p class="lede m-0">
      Everything public: the two magazines, the channels, the music, the notebooks, and the academic profile.
    </p>
  </header>

  <Section id="magazines" title="The two magazines" note="2 sites">
    <div class="flex flex-col gap-4">
      <article class="card p-6">
        <div class="flex items-start gap-4 mb-2">
          <img src={`${base}shots/alteranai-logo.png`} alt="alteranai.com" class="w-16 h-16 rounded-lg object-cover shrink-0" />
          <div class="flex-1 min-w-0">
            <div class="flex items-baseline justify-between gap-3 flex-wrap">
              <h3 class="text-[22px] font-semibold m-0 text-fg">alteranai.com</h3>
              <a href="https://alteranai.com/" target="_blank" rel="noopener" class="text-[17px] text-synapse no-underline">visit →</a>
            </div>
          </div>
        </div>
        <p class="text-[17.5px] text-fg-dim m-0 mb-3">
          AI engineering magazine in English: engineering and philosophy written from inside a running sovereign AI system.
          Topics are the measured work — retrieval that works, memory architecture, failure modes, sovereign inference, multi-agent systems that are not swarms, working with Claude, the stack, and measuring your own system.
        </p>
        <p class="text-[17px] text-fg-ghost m-0">
          Stack: Astro 7, static. Categories and clusters are data in src/data/site.ts; an article with an unknown category or cluster fails the build.
          Deploy: GitHub Pages on push to main; custom domain via SITE_URL and SITE_BASE.
        </p>
      </article>

      <article class="card p-6">
        <div class="flex items-start gap-4 mb-2">
          <img src={`${base}shots/aisvet-logo.jpg`} alt="aisvet.sk" class="w-16 h-16 rounded-lg object-cover shrink-0" />
          <div class="flex-1 min-w-0">
            <div class="flex items-baseline justify-between gap-3 flex-wrap">
              <h3 class="text-[22px] font-semibold m-0 text-fg">aisvet.sk</h3>
              <a href="https://aisvet.sk/" target="_blank" rel="noopener" class="text-[17px] text-synapse no-underline">visit →</a>
            </div>
          </div>
        </div>
        <p class="text-[17.5px] text-fg-dim m-0 mb-3">
          AI magazine in Slovak, practical. Astro as the CMS, Cloudflare in front, and a Cloudflare AI Search chat on the page.
          Topics: AI basics, AI in practice, AI trends, podcasts, video, infographics.
        </p>
        <p class="text-[17px] text-fg-ghost m-0">
          Stack: Astro 6, Pagefind search, Three.js for the cluster/RAG visuals, Cloudflare AI Search, AI Gateway, R2.
          Deploy: GitHub Pages / Cloudflare; 220 pages indexed in AI Search.
        </p>
      </article>
    </div>
  </Section>

  <Section id="channels" title="Channels" note="4">
    <div class="grid md:grid-cols-2 gap-3">
      <a href="https://www.youtube.com/@aisvet-sk" target="_blank" rel="noopener" class="card p-5 no-underline flex flex-col group">
        <b class="text-[19px] text-fg font-semibold mb-1.5">YouTube — Slovak</b>
        <p class="text-[17.5px] text-fg-dim m-0 flex-1">10 videos, the same material in video form.</p>
        <span class="text-[17px] text-synapse mt-2.5">youtube.com/@aisvet-sk →</span>
      </a>
      <a href="https://www.youtube.com/@alteranai" target="_blank" rel="noopener" class="card p-5 no-underline flex flex-col group">
        <b class="text-[19px] text-fg font-semibold mb-1.5">YouTube — English</b>
        <p class="text-[17.5px] text-fg-dim m-0 flex-1">AI engineering videos in English.</p>
        <span class="text-[17px] text-synapse mt-2.5">youtube.com/@alteranai →</span>
      </a>
      <a href="https://hearthis.at/aisvet/" target="_blank" rel="noopener" class="card p-5 no-underline flex flex-col group">
        <b class="text-[19px] text-fg font-semibold mb-1.5">hearthis — Slovak</b>
        <p class="text-[17.5px] text-fg-dim m-0 flex-1">The Third Space series and AI engineering episodes — building a team brain, autonomous agents, why company AI projects fail.</p>
        <span class="text-[17px] text-synapse mt-2.5">hearthis.at/aisvet/ →</span>
      </a>
      <a href="https://hearthis.at/alteran-ai/" target="_blank" rel="noopener" class="card p-5 no-underline flex flex-col group">
        <b class="text-[19px] text-fg font-semibold mb-1.5">hearthis — English</b>
        <p class="text-[17.5px] text-fg-dim m-0 flex-1">English-language AI engineering episodes.</p>
        <span class="text-[17px] text-synapse mt-2.5">hearthis.at/alteran-ai/ →</span>
      </a>
    </div>
  </Section>

  <Section id="suno" title="SUNO music" note="suno.com/@miso_m">
    <div class="card p-5">
      <p class="text-[18px] text-fg-dim m-0 mb-3">
        <a href="https://suno.com/@miso_m" target="_blank" rel="noopener" class="text-synapse">suno.com/@miso_m</a> — 5.8k plays, 193 likes, 127 songs.
      </p>
      <p class="text-[17.5px] text-fg-ghost m-0">
        Cyberpunk neuro-DnB experiments, including this site's theme song. The same AI work, in audio form.
      </p>
    </div>
  </Section>

  <Section id="repos" title="Repositories" note={`${lineageRepos.length + repos.length} public`}>
    <div class="grid md:grid-cols-2 gap-3">
      {[...lineageRepos, ...repos].map((r) => (
        <a href={r.url} target="_blank" rel="noopener" class="card p-4 no-underline flex flex-col group">
          <b class="text-[19px] text-fg font-semibold mb-1.5">{r.name}</b>
          <p class="text-[17.5px] text-fg-dim m-0 flex-1">{r.what}</p>
          {r.why && <p class="text-[17px] text-fg-ghost m-0 mt-1.5">{r.why}</p>}
          <span class="text-[17px] text-synapse mt-2.5 transition-transform group-hover:translate-x-0.5">open →</span>
        </a>
      ))}
    </div>
  </Section>

  <Section id="games" title="Games" note={`${games.length}`}>
    <div class="grid md:grid-cols-2 gap-3">
      {games.map((g) => (
        <div class="card p-5 flex flex-col">
          <b class="text-[20px] text-fg font-semibold mb-2">{g.name}</b>
          <p class="text-[18px] text-fg-dim m-0 mb-2">{g.what}</p>
          <p class="text-[17.5px] text-fg-ghost m-0 flex-1">{g.why.replaceAll('**', '')}</p>
          <span class="flex flex-wrap gap-4 mt-3">
            {g.play && <a href={g.play} class="text-[17px] text-synapse no-underline">play →</a>}
            {g.url && <a href={g.url} class="text-[17px] text-synapse no-underline">repo →</a>}
            {g.videos?.map((v) => <a href={v.url} class="text-[17px] text-synapse no-underline">{v.title} →</a>)}
          </span>
        </div>
      ))}
    </div>
  </Section>

  <Section id="notebooks" title="Research notebooks" note={`${academic.notebooks.items.length}`}>
    <div class="flex flex-col gap-3">
      {academic.notebooks.items.map((n) => (
        <div class="card p-5">
          <div class="flex items-baseline justify-between gap-4 flex-wrap mb-2">
            <b class="text-[19px] text-fg font-semibold">{n.title}</b>
            <span class="text-[17px] text-fg-ghost shrink-0 tabular-nums">
              {n.sources} {n.sources === 1 ? 'source' : 'sources'} · {n.when}
            </span>
          </div>
          <p class="text-[17.5px] text-fg-dim m-0 mb-2">{n.what}</p>
          <p class="text-[17.5px] text-synapse m-0 pl-3 border-l border-neural/40">{n.line}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section id="academic" title="Academic" note="Academia.edu">
    <a href={academic.profile.url} target="_blank" rel="noopener"
       class="card p-5 no-underline flex flex-col group">
      <div class="flex items-baseline justify-between gap-3 flex-wrap mb-3">
        <b class="text-[19px] text-fg font-semibold">{academic.profile.name}</b>
        <span class="text-[17px] text-fg-ghost">{academic.profile.where}</span>
      </div>
      <div class="flex flex-wrap gap-6 mb-3">
        {academic.profile.stats.map(([v, l]) => (
          <div>
            <div class="text-[25px] font-semibold lit-forge leading-none tabular-nums">{v}</div>
            <div class="text-[17px] text-fg-ghost mt-1">{l}</div>
          </div>
        ))}
      </div>
      <p class="text-[17.5px] text-fg-dim m-0">{academic.profile.what}</p>
      <span class="text-[17px] text-synapse mt-3 transition-transform group-hover:translate-x-0.5">open profile →</span>
    </a>
    <div class="card p-5 mt-3">
      <p class="text-[17.5px] text-fg-dim m-0 mb-3">{academic.profileNote}</p>
      <p class="text-[17.5px] text-fg-ghost m-0">{academic.whyPractical}</p>
    </div>
  </Section>
</Base>
