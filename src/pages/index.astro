---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Stat from '../components/Stat.astro';
import BarList from '../components/BarList.astro';
import Timeline, { type Entry } from '../components/Timeline.astro';
import Disclosure from '../components/Disclosure.astro';
import { qdrant, qdrantTotal, graphs, rules, capturedAt } from '../data/hive';
import { teamBrain } from '../data/team-brain';
import { repos, public_output } from '../data/work';
import { claudeStatement, references } from '../data/references';

const career: Entry[] = [
  {
    when: '2024 – 2026',
    what: 'Senior SEO Specialist → AI Engineer',
    where: 'msg life Slovakia (through my own company, full internal scope)',
    body: `Two and a half years. The move into AI began September 2025 and formalised as
      AI Engineer by February 2026, concluding with the delivery and handover of Team Brain.`,
    points: [
      'Built and handed over a production AI knowledge hub used by the whole content and web team',
      'Four AI workshops for the entire Slovak branch — leadership to newest hires, voluntary attendance',
      'The first workshop opened with ethics and the practical limits of formal logic, before Team Brain existed as anything but an idea',
    ],
    tags: ['TypeScript', 'PostgreSQL', 'Claude API', 'Next.js'],
  },
  {
    when: 'Sep – Dec 2025',
    what: 'Where the AI work actually started',
    where: 'Not a title change',
    pivot: true,
    body: `On a glossary project an agency was selling as a large generic content build, I wrote a
      markdown-driven generation framework instead — terms clustered by category, each cluster
      carrying its own sources and content structure over a shared content DNA, so the set stayed
      coherent while the clusters stayed genuinely different.`,
    points: [
      'It was team work and the framework was my part; it made the agency\'s proposal obsolete',
      'The hard part was not technical — it was saying we were paying a supplier for bloatware, from a position where that was not my brief',
      '<b>The principle everything since runs on:</b> the structure you impose on the input decides output quality far more than the model does',
    ],
  },
  {
    when: '2015 – 2023',
    what: 'Senior SEO Manager',
    where: 'Tippland Hamburg · Lottostarlet Malta · Lottoland Gibraltar',
    body: `Eight years building organic growth in one of the most competitive commercial verticals
      there is, across German-speaking and CEE markets.`,
    points: [
      'Grew German-market traffic <b>from zero to 30k monthly sessions</b> on the main property and <b>100k across satellites</b>, on budget',
      'Held <b>0.9% vested equity</b> in Lottostarlet',
      'Launched programmatic SEO reaching <b>top-3 rankings within weeks, with no paid backlinks</b>',
      'At Lottoland: 50% management (4 internal, 5 external, 3 markets), 50% hands-on; built and led 3 internal SEO trainings',
    ],
  },
  {
    when: '2012 – now',
    what: 'Founder',
    where: 'My Marketing s.r.o.',
    body: 'Consulting and delivery, alongside the roles above.',
    points: [
      'Co-founded a CEE sportswear e-commerce business reaching <b>€50k monthly turnover in its first year</b>',
      'Google Partner status: 10+ AdWords accounts, ~€10k monthly ad spend over two years',
      'Currently: custom sales CRM and a 3D sales configurator with one developer — my part is analysis, design and client presentation',
    ],
  },
  {
    when: '2015 – 2016',
    what: 'Marketing & IT Manager',
    where: 'Individual Auto Design (custom manufacturer)',
    body: `Five markets (DE, SK, CZ, HU, EN): built the sites, set up the web server, grew visitors,
      signups and orders month over month.`,
    points: [
      'Helped finish a <b>SAP-BO implementation that had been on hold for two years</b>, working with the IT supplier',
    ],
  },
  {
    when: '2010 – 2011',
    what: 'Associate Product Marketing Manager · Online Media Associate Program',
    where: 'Google — Prague, and European HQ Dublin',
    body: `B2B acquisition and local product marketing for CZ/SK, then a three-month program at the
      European headquarters supporting AdWords customers and improving the product's help surface.`,
    points: [
      'Ran the first targeted direct-mail campaign — <b>top 3 globally at Google by signup rate</b>',
      'Negotiated and signed 3 co-marketing partnerships in Slovakia',
      'Completed the Dublin program with strong feedback from two managers and <b>two peer bonuses</b>',
      'Continued as a <b>Google Student Ambassador</b> at my university',
    ],
  },
  {
    when: '2006 – 2009',
    what: 'ERP Tester → Sales Manager',
    where: 'Asseco Solutions (Helios Orange ERP), Prague',
    body: `Started at 19 testing the ERP and writing its documentation, then moved to selling it —
      both sides of software delivery before I was 23.`,
    points: [
      'Sold <b>14 successful ERP implementations</b>',
      'Negotiated in English with pilot customers in Germany and Poland',
    ],
  },
];
---
<Base
  title="Michal Malček — AI Engineer"
  description="AI engineer. One production system delivered and handed over, one running daily — built and measured on a single local machine."
>
  <header class="relative pt-20 pb-10">
    <span class="absolute bottom-0 left-0 right-0 h-px pointer-events-none"
          style="background: linear-gradient(90deg,
                   color-mix(in srgb, var(--color-neural) 65%, transparent) 0%,
                   color-mix(in srgb, var(--color-synapse) 35%, transparent) 35%,
                   var(--color-line) 75%, transparent 100%);
                 box-shadow: 0 0 16px -2px color-mix(in srgb, var(--color-neural) 55%, transparent)" />
    <div class="status-pill inline-flex items-center gap-2 text-[11px] tracking-[.14em] uppercase
                text-synapse border border-synapse rounded-full px-3 py-1 mb-5">
      <span class="w-[6px] h-[6px] rounded-full bg-synapse" style="animation: pulse 2.4s ease-in-out infinite" />
      Open to AI research engineering roles
    </div>

    <h1 class="text-[clamp(34px,6vw,58px)] leading-[1.04] font-semibold tracking-tight m-0 mb-3">
      <span class="glow-name">Michal Malček</span><br /><em
        class="not-italic text-neural-text glow-violet">AI Engineer</em>
    </h1>

    <p class="text-[clamp(15px,2vw,18px)] text-fg-dim max-w-[640px] m-0 mb-7">
      One production AI system delivered and handed over, one running daily — built and
      measured on one machine. No AI degree: one three-day course, then everything else
      learned from the systems themselves. I keep the record honest enough to count
      against myself.
    </p>

    <div class="flex flex-wrap gap-2.5">
      {[
        { href: 'mailto:miso.malcek@gmail.com', label: 'miso.malcek@gmail.com' },
        { href: '#hive',        label: 'The hive' },
        { href: '#results',     label: 'Results' },
        { href: '#apparatus',   label: 'The apparatus' },
        { href: '#research',    label: 'Research' },
        { href: '/credentials/', label: 'Credentials' },
      ].map((l) => (
        <a href={l.href}
           class="nav-link text-fg-dim no-underline border border-line rounded-lg px-3.5 py-2
                  text-[13px] transition-all">
          {l.label}
        </a>
      ))}
    </div>
  </header>

  <!-- ── Systems ──────────────────────────────────────────────────────── -->
  <Section id="work" title="Systems">
    <div class="card p-6 mb-4">
      <div class="flex items-baseline justify-between gap-3 flex-wrap">
        <h3 class="text-[19px] font-semibold m-0">Team Brain</h3>
        <span class="text-[12px] text-fg-ghost">built · deployed · handed over</span>
      </div>
      <div class="text-[12px] text-fg-ghost mt-1 mb-3">Production AI knowledge hub · 2026</div>
      <p class="text-fg-dim m-0 mb-3">
        Shared project memory for a software company's Slovak branch: a chat surface over the
        team's accumulated knowledge with 33 tools behind it, a six-specialist agent model with
        keyword and complexity routing, autonomous memory extraction from conversations, and
        scheduled analytics snapshots. Deployed on a Debian VPS at a live domain.
      </p>
      <p class="text-fg-dim m-0 mb-4">
        Handed over with a full decontamination pass and a separate zero-point copy, so it runs
        without me. <span class="text-fg-ghost">A production system only its author can operate
        is not delivered, it is lent.</span>
      </p>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-line border border-line rounded-lg overflow-hidden">
        {[
          ['15', 'users, all active'],
          [teamBrain.messages.toLocaleString('en-US'), 'messages · 446 conversations'],
          [`${teamBrain.toolSuccessPct}%`, `success over ${teamBrain.toolCalls.toLocaleString('en-US')} tool calls`],
          ['~49M', 'tokens processed'],
        ].map(([v, l]) => (
          <div class="bg-bg-el px-4 py-3">
            <div class="text-[19px] font-semibold text-forge leading-tight">{v}</div>
            <div class="text-[11px] text-fg-ghost leading-snug mt-0.5">{l}</div>
          </div>
        ))}
      </div>
      <p class="text-[12px] text-fg-ghost mt-3 mb-0">
        Aggregates from the production database at handover, {teamBrain.period}, on a {teamBrain.host}.
        Individual users and business content excluded.
      </p>

      <div class="flex flex-wrap gap-1.5 mt-4">
        {['Express 5', 'TypeScript', 'PostgreSQL', 'Next.js 16', 'React 19', 'Claude API', 'PM2 / Nginx'].map((t) => <span class="chip">{t}</span>)}
      </div>
    </div>

    <div class="card p-6">
      <div class="flex items-baseline justify-between gap-3 flex-wrap">
        <h3 class="text-[19px] font-semibold m-0">Factorium</h3>
        <span class="text-[12px] text-fg-ghost">running daily · open source from release</span>
      </div>
      <div class="text-[12px] text-fg-ghost mt-1 mb-3">Local-first AI environment · pre-release</div>
      <p class="text-fg-dim m-0 mb-3">
        A human and two models sharing one memory, one knowledge graph, one code graph and one
        plan. The local model runs long agentic tasks, writes code, drives a browser and queries
        the same stores I do — it is not a chat wrapper.
      </p>
      <p class="text-fg-dim m-0">
        Everything runs on a single 24&nbsp;GB Apple M4 with no cloud inference. That ceiling
        decided the architecture: a 12B model at 7.7&nbsp;GB resident instead of the stronger 26B
        at 16–17&nbsp;GB, because capability that costs you the rest of the machine is not
        capability.
      </p>
      <div class="flex flex-wrap gap-1.5 mt-4">
        {['TypeScript', 'llama.cpp / Metal', 'Gemma-4 12B', 'Qdrant', 'Apache AGE', 'pgvector', 'bge-m3', 'TimescaleDB'].map((t) => <span class="chip">{t}</span>)}
      </div>
    </div>

    <!-- The framework under both systems. One card, because the useful fraction
         is small and saying so is the point. -->
    <details class="card mt-4 group">
      <summary class="cursor-pointer px-6 py-4 text-[14px] flex items-center gap-3 list-none [&::-webkit-details-marker]:hidden">
        <span class="text-neural text-[19px] leading-none transition-transform duration-200 group-open:rotate-90">›</span>
        <span class="flex-1">Before both of them: a written framework, and how little of it survived</span>
        <span class="text-[11px] text-fg-ghost shrink-0">~10% in use</span>
      </summary>
      <div class="px-6 pb-6 pl-14 text-[13.5px] text-fg-dim">
        <p class="mt-0 mb-3">
          Roughly 44,000 lines specifying how a human and an AI should work together, written in my
          first months — before I could build any of it, which means much of it specifies a system I
          did not yet understand. Three things from it are load-bearing today:
          <b class="text-fg">an app standard</b> (every app declares a manifest and a two-sided
          service surface, validated at registry load), <b class="text-fg">shared stores</b> (the
          model queries the same memory, plan and code graph I do), and
          <b class="text-fg">an aesthetic layout engine</b> where visual form is derived from graph
          structure rather than decoration.
        </p>
        <p class="m-0 text-fg-ghost">
          The rest is concepts. I keep it because knowing which tenth was real took building both
          systems, and because two of its claims are still overstated in my own notes: the app
          standard logs violations rather than failing the build, so calling it "enforced" would be
          wrong; and the layout engine's later principles measure a problem they cannot yet solve.
        </p>
      </div>
    </details>
  </Section>

  <!-- ── The hive ─────────────────────────────────────────────────────── -->
  <Section
    id="hive"
    title="The hive, in numbers"
    note={`read ${capturedAt}`}
    lede="Factorium's stores as they stand right now — one person, one machine, no team and no budget. Read live from Postgres and Qdrant by a script rather than typed in, because a number you cannot re-derive is a claim, not a measurement."
  >
    <div class="flex items-center gap-2 text-[11px] tracking-[.12em] uppercase text-fg-ghost -mt-2 mb-5">
      <span class="relative inline-flex w-[7px] h-[7px]">
        <span class="absolute inset-0 rounded-full bg-synapse"
              style="box-shadow: 0 0 10px var(--color-synapse), 0 0 22px color-mix(in srgb, var(--color-synapse) 60%, transparent)" />
        <span class="absolute inset-0 rounded-full bg-synapse"
              style="animation: ripple 2.6s ease-out infinite" />
      </span>
      running while you read this
    </div>
    <div class="grid grid-cols-2 md:grid-cols-6 gap-3">
      <Stat label="Embedded points" value={qdrantTotal.toLocaleString('en-US')} accent="forge" span={3} delay={0}
            sub="Across seven Qdrant collections at 1024 dimensions.">
        <div class="mt-4"><BarList rows={qdrant} /></div>
      </Stat>

      <Stat label="Knowledge graph" value={graphs.knowledge.entities.toLocaleString('en-US')} accent="neural" span={3} delay={80}
            sub={`entities · <b>${graphs.knowledge.relationships.toLocaleString('en-US')}</b> relationships<br><span class="text-fg-ghost">106 decisions · 283 lessons · 608 concepts</span>`}>
        <div class="relative h-[74px] mt-3 opacity-85">
          {[[8,56,0],[26,22,.9],[41,68,1.9],[58,34,.5],[73,60,2.6],[89,28,1.4]].map(([l,t,d]) => (
            <span class="absolute w-[5px] h-[5px] rounded-full bg-synapse"
                  style={`left:${l}%; top:${t}%;
                          box-shadow: 0 0 8px var(--color-synapse),
                                      0 0 20px color-mix(in srgb, var(--color-synapse) 70%, transparent),
                                      0 0 40px color-mix(in srgb, var(--color-synapse) 35%, transparent);
                          animation: drift 7s ease-in-out ${d}s infinite`} />
          ))}
        </div>
      </Stat>

      <Stat label="Code graph" value={graphs.code.entities.toLocaleString('en-US')} accent="synapse" span={2} delay={160}
            sub={`entities · <b>${graphs.code.relationships.toLocaleString('en-US')}</b> relationships<br><span class="text-fg-ghost">import edges resolved through NodeNext, so blast radius is transitive — 36 files at depth 1, 52 at depth 2, in 34&nbsp;ms</span>`} />

      <Stat label="Living plan" value={graphs.plan.nodes.toLocaleString('en-US')} span={2} delay={240}
            sub={`plan nodes · ${graphs.plan.edges} edges across ${graphs.plan.projects} projects — the plan is a graph in the same database, not a document.`} />

      <Stat label="Behavioural rules" value={rules.rules} span={2} delay={320}
            sub={`rules · ${rules.triggers} situational triggers · defeasible, with overrides logged as data rather than treated as violations.`} />
    </div>
  </Section>

  <!-- ── Results ──────────────────────────────────────────────────────── -->
  <Section
    id="results"
    title="Results"
    lede="Numbers I can point at, across twenty years. Where something is unverifiable or ended badly, it says so."
  >
    <div class="grid md:grid-cols-3 gap-3 mb-6">
      {[
        { k: 'Traffic built from zero', v: '30k / 100k', s: 'monthly sessions, main site and satellites — German market, no paid links', a: 'forge' },
        { k: 'ERP implementations sold', v: '14', s: 'including EN negotiations with German and Polish pilot customers', a: 'neural' },
        { k: 'First-year turnover', v: '€50k', s: 'monthly, CEE e-commerce business I co-founded', a: 'synapse' },
        { k: 'Tool-call success rate', v: '93.9%', s: 'over 1,352 real calls by non-engineers, four months in production', a: 'forge' },
        { k: 'Direct-mail campaign', v: 'Top 3', s: 'globally at Google by signup rate — the first targeted one for CZ/SK', a: 'neural' },
        { k: 'Judo', v: '3×', s: 'Slovak champion · two years in national representation · ten years training', a: 'synapse' },
      ].map((r, i) => (
        <Stat label={r.k} value={r.v} sub={r.s} accent={r.a as any} delay={i * 60} />
      ))}
    </div>

    <div class="card p-5">
      <div class="eyebrow mb-4">Academic record</div>
      <div class="grid sm:grid-cols-2 gap-x-8 gap-y-3">
        {[
          ['Electrical Engineering & ICT — final year', '1.0', 'High School of Jozef Murgaš, Banská Bystrica'],
          ['Information Systems & Technologies (Master\'s, 41 ECTS)', '1.5', 'University of Economics Prague'],
          ['Applied Informatics (Bachelor\'s)', '1.6', 'University of Economics Prague — top 10 of ~500'],
          ['CEMS International Management (Master\'s, in English)', '1.7', 'Prague · Corvinus Budapest'],
        ].map(([what, grade, where]) => (
          <div class="flex items-baseline gap-3 border-b border-line/60 pb-2.5">
            <span class="text-[22px] font-semibold text-forge tabular-nums leading-none shrink-0 w-[38px]">{grade}</span>
            <span>
              <b class="block text-[13px] font-medium leading-snug">{what}</b>
              <span class="text-[11.5px] text-fg-ghost">{where}</span>
            </span>
          </div>
        ))}
      </div>
      <p class="text-[12.5px] text-fg-ghost mt-4 mb-0">
        Czech grading, where 1.0 is the best possible mark. Erasmus at Corvinus Budapest: A in every
        subject. The one I did not finish: the second business-language exam (Russian) in the CEMS
        programme — all mandatory courses and skill seminars completed, that exam not passed.
      </p>
    </div>
  </Section>

  <!-- ── The working layer ────────────────────────────────────────────── -->
  <Section
    id="apparatus"
    title="The apparatus, and what it cost to get right"
    lede="The part of this work that rarely gets written down: the tooling you build around a model, and how much of it turns out to be waste. Both counts below come from git history, not from memory."
  >
    <div class="grid md:grid-cols-2 gap-3 mb-4">
      <div class="card p-5">
        <div class="flex items-baseline justify-between gap-2 mb-3">
          <div class="eyebrow">Agents · Team Brain</div>
          <span class="text-[13px] text-forge font-semibold tabular-nums">{teamBrain.agentsWritten} → {teamBrain.agentsLive}</span>
        </div>
        <p class="text-[13.5px] text-fg-dim m-0 mb-3">
          I first built what I thought agentic meant: one specialised agent per task. It reached{' '}
          <b class="text-fg">{teamBrain.agentsWritten} definitions</b> and became unusable — nobody
          could tell which to reach for. The names were accurate and useless: you cannot choose
          between two analytics agents unless you already know the answer.
        </p>
        <p class="text-[13px] text-fg-ghost m-0">
          The redesign collapsed them into <b class="text-fg-dim">six specialists</b>, each
          absorbing the narrow agents it replaced as loadable context rather than a top-level
          choice. <b class="text-fg-dim">A capability taxonomy is a UX decision, not an
          architecture decision</b> — the right number is what a person can hold in their head
          while typing a question.
        </p>
      </div>

      <div class="card p-5">
        <div class="flex items-baseline justify-between gap-2 mb-3">
          <div class="eyebrow">My own instruction set</div>
          <span class="text-[13px] text-forge font-semibold tabular-nums">18 → 7</span>
        </div>
        <p class="text-[13.5px] text-fg-dim m-0 mb-3">
          An audit found that two of my working instructions had been written for an entirely
          different product and never adapted; one assumed a framework this codebase does not use;
          one described a database schema we had migrated away from; one referenced four expert
          personas that were never built. All had been loading for months.
        </p>
        <p class="text-[13px] text-fg-ghost m-0">
          <b class="text-fg-dim">Instructions rot silently and confidently.</b> Code that references
          a deleted module fails to compile; prose that references a deleted concept keeps sounding
          authoritative. The fix was binding each instruction to a concrete tool call, so a stale
          one breaks instead of merely misleading.
        </p>
      </div>
    </div>

    <div class="card p-5 mb-4">
      <div class="eyebrow mb-4">Tool surface: two models, two very different budgets</div>
      <div class="grid sm:grid-cols-2 gap-6">
        <div>
          <div class="text-[12px] text-fg-ghost mb-2">Large cloud model</div>
          <div class="text-[24px] font-semibold text-neural-text leading-none mb-2">full surface</div>
          <p class="text-[12.5px] text-fg-dim m-0">Context is cheap relative to capability, so
            curation would cost more than it saves.</p>
        </div>
        <div>
          <div class="text-[12px] text-fg-ghost mb-2">Local 12B model</div>
          <div class="text-[24px] font-semibold text-synapse leading-none mb-2">22 of 60</div>
          <p class="text-[12.5px] text-fg-dim m-0">Curated per turn, the rest reachable through a
            search tool. Past roughly 15–20 always-visible schemas, a small model's tool selection
            degrades sharply.</p>
        </div>
      </div>
      <p class="text-[12.5px] text-fg-ghost mt-4 mb-0 pt-3 border-t border-line/60">
        Voice gets a third and smaller surface: read-only. Spoken interaction has no confirmation
        step, so nothing that writes is reachable that way — a blast-radius decision, not a
        capability one.
      </p>
    </div>

    <div class="card p-5">
      <div class="eyebrow mb-3">On protocol layers — why most of ours were removed</div>
      <p class="text-[13.5px] text-fg-dim m-0 mb-3">
        We ran two browser integrations through the standard tool protocol. Measured usage over the
        period: <b class="text-fg">1,548 calls to one, approximately zero to the other</b>. The
        second was not adding capability, it was adding a decision — <em>which one?</em> — at every
        step. Removed. Everything the hive itself does is served natively over plain HTTP instead,
        which puts one less layer between a call and its failure mode.
      </p>
      <p class="text-[13px] text-fg-ghost m-0">
        <b class="text-fg-dim">The rule I would defend:</b> a protocol layer earns its place when it
        lets you use somebody else's implementation. When you own both sides of the interface, it is
        indirection with a specification attached. We keep it for fetching external content and
        driving a browser — genuinely external things, where someone else's implementation beats
        one we would write.
      </p>
    </div>
  </Section>

  <!-- ── What went wrong ──────────────────────────────────────────────── -->
  <Section
    id="wrong"
    title="What went wrong"
    lede="These cost real time and are written down because the corrections are the part worth reading. Each one is a stored record, not a recollection."
  >
    <Disclosure summary="Using an embedding model outside its contract" tag="weeks">
      <p>nomic-embed requires asymmetric prefixes on queries and documents. Served through
      llama.cpp, nothing adds them, so everything was embedded symmetrically. Symptom: short
      meaningless text outranked long relevant text.</p>
      <p>The diagnosis method has since caught every similar defect — <em>embed a stored document
      both ways and compare each against its own stored vector.</em> Whichever scores 1.0000 tells
      you how it was really indexed.</p>
      <p class="text-forge">Cost: 10,676 records re-embedded. And the first repair script read only
      the body field while the writer had embedded title + body together — 95% of records would
      have silently lost their titles from their vectors. Nothing would have errored.</p>
    </Disclosure>

    <Disclosure summary="A migration that left its satellites behind" tag="days of silent loss">
      <p>Moving to a 1024-dimension embedding model updated the server and the main paths, but not
      eight standalone ingest scripts. The code indexer failed on every write for days, so the code
      graph ingested nothing. The failure was loud in a log nobody was reading.</p>
      <p>Root cause found later: the model and port live in the service's launchd plist, not in any
      shell, so every hand-run script fell back to the old model. Fixed twice at the symptom before
      being fixed at the source.</p>
    </Disclosure>

    <Disclosure summary="Adding a speech-to-text model, then removing it">
      <p>Voice transcription was poor, so I downloaded Whisper and benchmarked it. It won — on
      synthetic clips. On real microphone recordings the multimodal model transcribed correctly and
      the premise collapsed. Synthetic fixtures had misled me four separate times by then.</p>
      <p>The actual defect was the prompt: told to "transcribe this", the model answered the
      question it heard instead of writing it down. Recast as a transcription <em>service</em>, it
      returned exact text including filler words. No new model, no extra gigabytes.</p>
    </Disclosure>

    <Disclosure summary="The pattern behind 35 of 46 recorded mistakes" tag="the real one">
      <p>A check comes back empty and I read the emptiness as an answer. A filter eats an error. A
      key I read does not exist, so the value is zero, so I conclude the tool is broken. A directory
      listing fails on a permission error I do not read, so I report the folder as empty.</p>
      <p>You cannot learn this from a book, because a book cannot show you your own reflex. You
      learn it by keeping a record honest enough to count against yourself — and then counting.
      There is an automated check for it now, and I still break it.</p>
    </Disclosure>

    <!-- The operating principles, stated as consequences of the failures above
         rather than as a separate creed. Each one names the decision it changed. -->
    <div class="card p-5 mt-5">
      <div class="eyebrow mb-4">What those cost me, stated as rules</div>
      <div class="grid sm:grid-cols-2 gap-x-8 gap-y-3">
        {[
          ['Suspect the measurement before the thing measured', 'The rule behind 35 of 46 errors. An empty result is a question, not an answer.'],
          ['A green exit code is not success — read the counts', 'An indexer reported "completed" while processing 194 files into 0 entities.'],
          ['Verify with a query whose answer you already know', 'Every real defect this year surfaced this way. None came from a passing test.'],
          ['Report the running process, never the config', 'A dashboard read configuration and called a live service down. A wrong red light is worse than none.'],
        ].map(([rule, why]) => (
          <div class="border-l-2 border-neural/40 pl-3">
            <b class="text-[13px] block leading-snug">{rule}</b>
            <span class="text-[12.5px] text-fg-ghost">{why}</span>
          </div>
        ))}
      </div>
      <p class="text-[12.5px] text-fg-ghost mt-4 mb-0 pt-3 border-t border-line/60">
        These are stored as queryable records rather than as a document, retrieved by describing the
        situation rather than naming the rule — which is what the research below measures. Ten of
        sixteen changed nothing when tested, and that result is in the paper too.
      </p>
    </div>
  </Section>

  <!-- ── Research ─────────────────────────────────────────────────────── -->
  <Section id="research" title="Research" note="2 papers">
    <div class="card p-6 mb-4">
      <h3 class="text-[19px] font-semibold m-0 mb-1">Measuring whether behavioural rules change model decisions</h3>
      <div class="text-[12px] text-fg-ghost mb-3">12 rounds · two models · August 2026</div>
      <p class="text-fg-dim m-0 mb-3">
        Rules for LLM agents are usually written, stored and assumed to work. I measured whether
        mine do, across three questions that normally get conflated: can a rule be
        <em>retrieved</em>, does it <em>change</em> a decision, and does the model <em>know</em>
        which of its rules help it.
      </p>
      <div class="grid sm:grid-cols-3 gap-3 my-4">
        {[
          ['1 in 5 → 10/10', 'retrieval, once rules were stored as the situations they govern rather than as their own wording'],
          ['6 of 16', 'rules measurably changed a decision · 10 changed nothing · none made a decision worse'],
          ['7 of 8', 'misclassified by the model when asked which of its own rules carried real information'],
        ].map(([v, l]) => (
          <div class="border-l-2 border-neural/40 pl-3">
            <div class="text-[17px] font-semibold text-fg leading-tight">{v}</div>
            <div class="text-[12px] text-fg-ghost leading-snug mt-1">{l}</div>
          </div>
        ))}
      </div>
      <p class="text-fg-dim m-0 mb-3">
        <b>A model can follow a rule without being able to judge one.</b> Three of the rules it
        dismissed as "just advice" had changed its own behaviour minutes earlier. Rule value has to
        be measured behaviourally, never by asking — had I trusted the self-report, I would have
        deleted seven working rules.
      </p>
      <p class="text-[13px] text-fg-ghost m-0 mb-4">
        Seven candidate designs were rejected on evidence: prompt-resident rules, rules in the
        existing graph (top-K collapse), score thresholding, automatic contradiction detection,
        a background guard (254 false alarms per true positive), per-rule hooks, and a solver layer.
      </p>

      <div class="border-t border-line/60 pt-4">
        <div class="text-[10.5px] tracking-[.14em] uppercase text-fg-ghost mb-3">
          Deployed · read from the database, not recalled
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-3">
          {[
            [rules.rules, 'rules'],
            [rules.triggers, 'situational triggers'],
            ['5', 'carry an <i>unless</i> clause'],
            ['2', 'trigger hits so far'],
          ].map(([v, l]) => (
            <div>
              <div class="text-[19px] font-semibold text-fg leading-none">{v}</div>
              <div class="text-[11px] text-fg-ghost leading-snug mt-1" set:html={l} />
            </div>
          ))}
        </div>
        <p class="text-[12.5px] text-fg-ghost m-0">
          Two hits is not adoption — but the counter moved off zero on its own, and both firings
          were the class the design predicted: <i>"a health check reports green but the function does
          not work"</i> and <i>"you are claiming a result without fresh evidence."</i>
          <b class="text-fg-dim">The counter itself was broken for part of the study</b> and
          reported a zero that was an unasked question rather than a measurement — the same failure
          class the research is about, occurring inside it.
        </p>
      </div>
      <a href="/research/rules/" class="chip no-underline mt-4 inline-block hover:border-neural transition-colors">
        Read the full study →
      </a>
    </div>

    <div class="card p-6">
      <h3 class="text-[19px] font-semibold m-0 mb-1">AI engineering — systems, decisions, and what they cost</h3>
      <div class="text-[12px] text-fg-ghost mb-3">Technical account · two systems · stack decisions and their corrections</div>
      <p class="text-fg-dim m-0 mb-3">
        The architecture behind both systems and the reasoning that produced it: one database
        instead of three, a migration of 17,109 vectors and what it bought, a 12B model chosen over
        a stronger 26B, and no agent framework — because a framework that injects prompt content
        you cannot see is fatal when you are measuring how a small model behaves.
      </p>
      <p class="text-[13px] text-fg-ghost m-0">
        Includes a full section on the decisions that were wrong, and what each one cost.
      </p>
      <a href="/research/engineering/" class="chip no-underline mt-4 inline-block hover:border-neural transition-colors">
        Read the full report →
      </a>
    </div>
  </Section>

