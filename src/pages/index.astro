---
// @ts-nocheck
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
import Base from '../layouts/Base.astro';
import fs from 'node:fs';

const CV_PATH = 'public/downloads/Malcek-CV-19112026.md';
const cvMd = fs.readFileSync(CV_PATH, 'utf8');

// Hero is the name, role and contact. The body is the markdown from section 01,
// once. The "Last update" line is the footer, not a second block of prose.
const splitMarker = '## 01 Summary';
const splitIndex = cvMd.indexOf(splitMarker);
let restMd = splitIndex >= 0 ? cvMd.slice(splitIndex) : '';
const updated = cvMd.match(/Last update:\s*(.+)/)?.[1]?.trim() ?? '';
restMd = restMd.replace(/\n*Last update:.*$/s, '').trim();

function md2html(md) {
  // Join wrapped paragraph lines (same logic as build-pdfs.mjs).
  md = md.split('\n').reduce((acc, line) => {
    const isBreak = (l) => l === '' || /^(#{1,4}\s|[-*]\s|\d+\.\s|\||>|```|---)/.test(l);
    const isCont = (l) => l !== '' && !isBreak(l);
    const prev = acc[acc.length - 1];
    const prevOpens = prev !== undefined && (isCont(prev) || /^([-*]\s|\d+\.\s)/.test(prev));
    if (prevOpens && isCont(line)) {
      acc[acc.length - 1] = prev + ' ' + line.trim();
    } else acc.push(line);
    return acc;
  }, []).join('\n');

  const esc = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  const inline = (s) => esc(s)
    .replace(/`([^`]+)`/g, '<code>$1</code>')
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
    .replace(/(^|[\s(])\*([^*\n]+)\*/g, '$1<em>$2</em>')
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>')
    .replace(/(^|[\s(])(https?:\/\/[^\s<)]+)/g, '$1<a href="$2">$2</a>');

  const out = [];
  let inTable = false, inList = false, inCode = false;
  for (const raw of md.split('\n')) {
    const line = raw.trimEnd();
    if (line.startsWith('```')) {
      out.push(inCode ? '</pre>' : '<pre>'); inCode = !inCode; continue;
    }
    if (inCode) { out.push(esc(raw)); continue; }
    if (line.startsWith('|')) {
      const cells = line.split('|').slice(1, -1).map((c) => c.trim());
      if (/^[-: |]+$/.test(line)) continue;
      if (!inTable) { out.push('<table>'); inTable = true; }
      const tag = out[out.length - 1] === '<table>' ? 'th' : 'td';
      out.push('<tr>' + cells.map((c) => `<${tag}>${inline(c)}</${tag}>`).join('') + '</tr>');
      continue;
    }
    if (inTable) { out.push('</table>'); inTable = false; }
    const li = line.match(/^[-*]\s+(.*)/) || line.match(/^\d+\.\s+(.*)/);
    if (li) {
      if (!inList) { out.push('<ul class="cv-list">'); inList = true; }
      out.push(`<li>${inline(li[1])}</li>`); continue;
    }
    if (inList) { out.push('</ul>'); inList = false; }
    const h = line.match(/^(#{1,4})\s+(.*)/);
    if (h) { out.push(`<h${h[1].length}>${inline(h[2])}</h${h[1].length}>`); continue; }
    if (line.startsWith('> ')) { out.push(`<blockquote>${inline(line.slice(2))}</blockquote>`); continue; }
    if (line === '---') { out.push('<hr>'); continue; }
    out.push(line ? `<p>${inline(line)}</p>` : '');
  }
  if (inTable) out.push('</table>');
  if (inList) out.push('</ul>');
  return out.join('\n');
}

function styleBlock(block: string) {
  const m = block.match(/^(<h2>[\s\S]*?<\/h2>)([\s\S]*)$/);
  if (!m) return block;
  let body = m[2].trim();
  if (body.includes('<h3>')) {
    body = body.replace(/(<h3>[\s\S]*?)(?=<h3>|$)/g, (chunk) =>
      chunk.trim() ? `<article class="card cv-role p-5 sm:p-6">${chunk.trim()}</article>` : '');
  } else if (body) {
    body = `<article class="card cv-role p-5 sm:p-6">${body}</article>`;
  }
  const h2 = m[1].replace('<h2>', '<h2 class="section-title">');
  return `<section class="cv-section">${h2}${body}</section>`;
}

const restHtml = md2html(restMd)
  .split(/(?=<h2>)/)
  .map(styleBlock)
  .join('\n');
---

<Base
  title="Michal Malček — AI Engineer — LLM Systems, RAG, Agentic AI"
  description="AI Engineer who builds agentic large language model (LLM) systems end-to-end."
  updated={updated}
>
  <header class="relative pt-8 pb-6">
    <h1 class="text-[clamp(44px,7vw,74px)] leading-[1.02] font-semibold tracking-tight m-0 mb-2">
      <span class="glow-name">Michal Malček</span>
    </h1>
    <p class="not-italic text-neural-text glow-violet text-[clamp(22px,3vw,34px)] font-semibold leading-tight m-0 mb-5">
      AI Engineer — LLM Systems, RAG, Agentic AI
    </p>

    <div class="flex items-center gap-2 flex-wrap">
      <a href="mailto:miso.malcek@gmail.com" class="pill">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 6h16v12H4zM4 7l8 6 8-6"/></svg>
        miso.malcek@gmail.com
      </a>
      <a href="tel:+421950200395" class="pill">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 3h4l2 5-3 2a12 12 0 006 6l2-3 5 2v4a2 2 0 01-2 2A16 16 0 015 5a2 2 0 012-2z"/></svg>
        +421 950 200 395
      </a>
      <span class="pill">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 21s7-6.2 7-11a7 7 0 10-14 0c0 4.8 7 11 7 11z"/><circle cx="12" cy="10" r="2.2"/></svg>
        Poprad, Slovakia · 2 h flight to London
      </span>
    </div>
  </header>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-2">
      <a href="https://misomalcek.github.io/cyber-cv/portfolio/" class="card p-4 no-underline flex flex-col">
        <span class="text-[17px] text-fg-ghost mb-1">Portfolio</span>
        <span class="text-[19px] text-fg font-semibold">Portfolio</span>
        <span class="text-[16px] text-synapse mt-1">https://misomalcek.github.io/cyber-cv/portfolio/</span>
      </a>
      <a href="https://github.com/misomalcek" class="card p-4 no-underline flex flex-col">
        <span class="text-[17px] text-fg-ghost mb-1">GitHub</span>
        <span class="text-[19px] text-fg font-semibold">GitHub</span>
        <span class="text-[16px] text-synapse mt-1">https://github.com/misomalcek</span>
      </a>
      <a href="https://www.linkedin.com/in/misomalcek/" class="card p-4 no-underline flex flex-col">
        <span class="text-[17px] text-fg-ghost mb-1">LinkedIn</span>
        <span class="text-[19px] text-fg font-semibold">LinkedIn</span>
        <span class="text-[16px] text-synapse mt-1">https://www.linkedin.com/in/misomalcek/</span>
      </a>
    </div>
  <div class="cv-body" set:html={restHtml} />
</Base>

<style is:global>
  .pill {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 7px 14px; border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-synapse) 70%, transparent);
    color: var(--color-fg); font-size: 16px; text-decoration: none;
    background: color-mix(in srgb, var(--color-bg) 40%, transparent);
  }
  .pill:hover { color: var(--color-synapse); }
  .cv-section { padding-top: 1.75rem; }
  .cv-section > .section-title { margin-bottom: 0.85rem; }
  .cv-role { margin-top: 0.75rem; }
  .cv-role h3 {
    margin: 0 0 0.2rem;
    font-size: clamp(20px, 1.8vw, 23px);
    font-weight: 650;
    line-height: 1.25;
    color: var(--color-fg);
    letter-spacing: -0.01em;
  }
  .cv-role h3 a { color: var(--color-synapse); text-decoration: none; }
  .cv-role h3 a:hover { text-decoration: underline; }
  .cv-role > p { margin: 0.15rem 0 0; color: var(--color-fg-ghost); font-size: 16px; }
  .cv-role ul {
    margin: 0.85rem 0 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    list-style: disc;
  }
  .cv-role li { color: var(--color-fg-dim); line-height: 1.55; }
  .cv-list { margin: 0.6rem 0 0.9rem; padding-left: 1.25rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .cv-list li { color: var(--color-fg-dim); line-height: 1.55; }
  .cv-list li strong { color: var(--color-fg); font-weight: 600; }
  .cv-role li strong { color: var(--color-fg); font-weight: 600; }
  .cv-role li a { color: var(--color-synapse); }
  .cv-role p + ul { margin-top: 0.6rem; }
  .cv-section > .section-title::after {
    content: ""; display: block; height: 1px; margin-top: 0.6rem;
    background: linear-gradient(90deg, color-mix(in srgb, var(--color-neural) 40%, transparent), transparent);
  }
</style>
