---
// Astro returns BASE_URL without a trailing slash at the root but with one
// under a subpath; normalise so `${base}x` is never `/cyber-cvx`.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import { rules, rulesSummary } from '../../data/rules-full';

const papers = await getCollection('research');

const meta: Record<string, { title: string; blurb: string; findings: string[] }> = {
  rules: {
    title: 'Measuring whether behavioural rules change model decisions',
    blurb: 'Rules for LLM agents are usually written, stored and assumed to work. This measures whether they do.',
    findings: [
      'Retrieval by rule wording: 1 in 5. Stored as the situations they govern: 10/10.',
      '6 of 16 rules changed a decision · 10 changed nothing · none made a decision worse.',
      'Asked which of its rules carried real information, the model misclassified 7 of 8.',
    ],
  },
  spatial: {
    title: 'Where a node sits should mean something',
    blurb: 'A graph that imploded, and what fixing it revealed about making geometry machine-readable.',
    findings: [
      'Hub implosion traced to degree-blind repulsion; the standard fix restored a flyable orbital structure.',
      'Position is only actionable to a language model as discrete tokens — stored tier and cluster, not raw coordinates.',
      '1,512 of 3,039 entities silently lost their tier after one session: a derived global property is a cache.',
    ],
  },
  engineering: {
    title: 'AI engineering — systems, decisions, and what they cost',
    blurb: 'A technical account of two systems, the stack decisions behind them, and the corrections.',
    findings: [
      'One database instead of three · 17,109 vectors migrated · a 12B model chosen over a stronger 26B.',
      'No agent framework, because injected prompt content is fatal when you are measuring a small model.',
      'A full section on the decisions that were wrong, with what each one cost.',
    ],
  },
  'una-synthesis': {
    title: 'The cognitive biotope — a local model\'s synthesis',
    blurb: 'The 12B local agent was asked to audit the three papers above against the system\'s own records and say what was wrong, unfair or incomplete. Unedited output.',
    findings: [
      'Two of its criticisms were correct and changed the papers — including that the rules were presented without their genesis.',
      'It surfaced a number the papers had not: roughly 60% of the earlier instruction apparatus was well-intentioned waste.',
      'It is also wrong once, and that is left in: it declared a layout algorithm absent after a failed string search.',
    ],
  },
};
const order = ['rules', 'spatial', 'engineering', 'una-synthesis'];
const sorted = [...papers].sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
---
<Base
  title="Research — Michal Malček"
  description="Measurement-first research on LLM agent behaviour and local-first AI systems."
  back={{ href: `${base}`, label: 'Back to CV' }}
>
  <header class="pt-10 pb-8 border-b border-line">
    <h1 class="text-[clamp(28px,4vw,40px)] font-semibold tracking-tight m-0 mb-3">Research</h1>
    <p class="text-fg-dim max-w-[660px] m-0">
      Written from stored records rather than recollection. Every figure comes from a query or a
      logged measurement, including the ones that count against the conclusion I wanted.
    </p>
  </header>

  <Section title="Papers" note={`${sorted.length}`}>
    <div class="flex flex-col gap-4">
      {sorted.map((p) => {
        const m = meta[p.id];
        return (
          <a href={`${base}research/${p.id}/`} class="card p-6 no-underline block group">
            <div class="flex items-baseline justify-between gap-4 flex-wrap">
              <h2 class="text-[18px] font-semibold text-fg m-0 group-hover:text-synapse transition-colors">
                {m.title}
              </h2>
              <span class="text-[12px] text-fg-ghost shrink-0">
                {p.data.timestamp.toISOString().slice(0, 10)}
              </span>
            </div>
            <p class="text-fg-dim text-[14px] mt-2 mb-4">{m.blurb}</p>
            <ul class="list-none p-0 m-0 flex flex-col gap-1.5">
              {m.findings.map((f) => (
                <li class="text-[13px] text-fg-ghost pl-4 relative">
                  <span class="absolute left-0 top-[9px] w-[5px] h-[1px] bg-neural" />{f}
                </li>
              ))}
            </ul>
            <span class="chip mt-4 inline-block group-hover:border-neural transition-colors">Read →</span>
          </a>
        );
      })}
    </div>
  </Section>

  <!-- ── The rules themselves ──────────────────────────────────────────────
       Published in full. A reader cannot check "these were arrived at, not
       designed" against a summary — only against the rules, their origins and
       their exceptions. -->
  <Section title="All sixteen rules, in full" note={`${rulesSummary.triggers} triggers`}
           lede="The complete set the research measures, verbatim from the table that serves them. Each shows where it came from — most trace to a specific incident — and five carry an explicit exception, which is what makes them defeasible rather than absolute.">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-5">
      {[[rulesSummary.count, 'rules'], [rulesSummary.triggers, 'situational triggers'],
        [rulesSummary.withUnless, 'with an explicit exception'], [rulesSummary.hits, 'triggers fired to date']].map(([v, l]) => (
        <div class="card p-4">
          <div class="text-[24px] font-semibold lit-forge leading-none">{v}</div>
          <div class="text-[12px] text-fg-ghost mt-1.5">{l}</div>
        </div>
      ))}
    </div>
    <ol class="list-none p-0 m-0 flex flex-col gap-2.5">
      {rules.map((r) => (
        <li class="card p-4">
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-2">
            <code class="text-[13px] text-synapse">{r.id}</code>
            <span class="text-[11.5px] text-fg-ghost">{r.triggers} triggers{r.hits > 0 ? ` · fired ${r.hits}×` : ''}</span>
          </div>
          <p class="text-[14px] text-fg m-0">{r.statement}</p>
          {r.unless && (
            <p class="text-[13px] text-forge m-0 mt-2">
              <b class="uppercase tracking-wider text-[11px] mr-1.5">unless</b>{r.unless}
            </p>
          )}
          <p class="text-[12px] text-fg-ghost m-0 mt-2">{r.origin}</p>
        </li>
      ))}
    </ol>
    <p class="text-[13px] text-fg-ghost mt-5 max-w-[70ch]">
      Two triggers have fired in production use. That number is small, it is shown rather than
      omitted, and it is the honest state of a system measured for weeks rather than years —
      the rules earn their place by changing decisions in testing, not by how often they fire.
    </p>
  </Section>
</Base>
