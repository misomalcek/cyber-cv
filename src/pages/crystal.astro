---
// Astro returns BASE_URL without a trailing slash at the root but with one
// under a subpath; normalise so `${base}x` is never `/cyber-cvx`.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import { nodes, crystalStats, TIER_NAMES } from '../data/crystal';

const byTier = TIER_NAMES.map((name, i) => ({
  name, n: nodes.filter((x) => x.tier === i).length,
})).filter((t) => t.n);

const byType = [...new Set(nodes.map((n) => n.type))]
  .map((type) => ({ type, n: nodes.filter((x) => x.type === type).length }))
  .sort((a, b) => b.n - a.n);
---
<Base
  title="The crystal — Michal Malček"
  description="A slice of the knowledge graph this CV stands on, rendered from its real degree, tier and cluster."
  back={{ href: `${base}#hive`, label: 'Back to CV' }}
>
  <header class="pt-10 pb-7">
    <div class="eyebrow mb-3">The hive, seen from inside</div>
    <h1 class="text-[clamp(26px,3.6vw,38px)] font-semibold tracking-tight leading-tight m-0 mb-3">
      <span class="glow-name">The crystal</span>
    </h1>
    <p class="text-fg-dim m-0 max-w-[640px]">
      Every entity this CV talks about, positioned by what the graph actually knows about it.
      Distance from the centre is <b class="text-fg">degree</b> — how many relationships an entity
      has. Colour is <b class="text-fg">type</b>. Size is centrality tier. Nothing here is decided
      by hand: the layout is a function of the data.
    </p>
  </header>

  <div class="relative rounded-2xl overflow-hidden border border-line mb-4"
       style="background: radial-gradient(ellipse at 50% 45%, #1A1040 0%, #0A0812 70%)">
    <canvas id="crystal" class="block w-full" style="height: min(62vh, 560px)"></canvas>

    <div class="absolute top-4 left-4 text-[11px] text-fg-ghost pointer-events-none select-none">
      <div class="uppercase tracking-[.14em] mb-1.5">drag to orbit · scroll to zoom · click a node</div>
      <div id="crystal-hover" class="text-fg-dim h-4"></div>
    </div>

    <!-- Entity detail, mirroring the popup the real graph app uses. -->
    <div id="crystal-popup"
         class="hidden absolute top-4 right-4 z-20 w-[300px] max-h-[calc(100%-2rem)] overflow-y-auto
                card p-4"></div>

    <div class="absolute bottom-0 left-0 right-0 flex flex-wrap gap-3 text-[11px] px-4 py-3
                pointer-events-none"
         style="background: linear-gradient(to top, #0A0812dd, transparent)">
      {byType.map((t) => (
        <span class="inline-flex items-center gap-1.5 text-fg-ghost">
          <span class="w-2 h-2 rounded-full" data-legend={t.type}></span>{t.type} · {t.n}
        </span>
      ))}
    </div>
  </div>

  <Section title="What you are looking at" note={`${crystalStats.nodes} of ${crystalStats.graphEntities} entities`}>
    <div class="grid md:grid-cols-3 gap-3 mb-4">
      <div class="card p-5">
        <div class="eyebrow mb-2">Selection</div>
        <p class="text-[13px] text-fg-dim m-0">
          An entity appears here if it is CORE or MAJOR in the full graph <b class="text-fg">and</b>
          this CV mentions it. That is a deliberately narrow slice: it shows the part of the graph
          this document actually stands on, not a flattering cross-section of the whole thing.
        </p>
      </div>
      <div class="card p-5">
        <div class="eyebrow mb-2">Position</div>
        <p class="text-[13px] text-fg-dim m-0">
          Radius is inverse degree — the most connected entities sit closest to the centre. That is
          the opposite of the layout's first version, which pulled hubs inward until the graph
          imploded into an unreadable core. <a href={`${base}research/spatial/`}>The paper on that</a> is
          the reason this renders at all.
        </p>
      </div>
      <div class="card p-5">
        <div class="eyebrow mb-2">Honesty</div>
        <p class="text-[13px] text-fg-dim m-0">
          <b class="text-fg">This is static.</b> The degrees, tiers and clusters were queried from
          Postgres on {crystalStats.capturedAt} and frozen into the page — a CDN has no database
          behind it. The structure is real; the liveness is not, and saying otherwise would be the
          kind of claim the rest of this site argues against.
        </p>
      </div>
    </div>

    <div class="card p-5">
      <div class="grid sm:grid-cols-2 gap-6">
        <div>
          <div class="eyebrow mb-3">By tier</div>
          {byTier.map((t) => (
            <div class="flex items-baseline justify-between text-[13px] py-1 border-b border-line/40 last:border-b-0">
              <span class="text-fg-dim">{t.name}</span>
              <span class="text-fg tabular-nums">{t.n}</span>
            </div>
          ))}
        </div>
        <div>
          <div class="eyebrow mb-3">Most connected</div>
          {nodes.slice(0, 6).map((n) => (
            <div class="flex items-baseline justify-between text-[13px] py-1 border-b border-line/40 last:border-b-0">
              <span class="text-fg-dim truncate pr-3">{n.name}</span>
              <span class="text-fg-ghost tabular-nums shrink-0">{n.deg}</span>
            </div>
          ))}
        </div>
      </div>
      <p class="text-[12px] text-fg-ghost mt-4 mb-0 pt-3 border-t border-line/60">
        {crystalStats.edges} relationships connect these {crystalStats.nodes} entities. In the full
        graph they carry {nodes.reduce((s, n) => s + n.deg, 0).toLocaleString('en-US')} between them
        — most of which point at entities outside this slice.
      </p>
    </div>
  </Section>
</Base>

<script>
  import * as THREE from 'three';
  import { nodes, edges } from '../data/crystal';

  const canvas = document.getElementById('crystal') as HTMLCanvasElement;
  const hoverLabel = document.getElementById('crystal-hover')!;
  const popup = document.getElementById('crystal-popup')!;

  const TYPE_COLOUR: Record<string, number> = {
    concept: 0xa855f7, technology: 0x22d3ee, project: 0xfbbf24,
    person: 0xf472b6, lesson: 0x9061f9, decision: 0x34d399,
  };
  const colourFor = (t: string) => TYPE_COLOUR[t] ?? 0x8a82ad;
  const hex = (c: number) => `#${c.toString(16).padStart(6, '0')}`;

  document.querySelectorAll<HTMLElement>('[data-legend]').forEach((el) => {
    const c = hex(colourFor(el.dataset.legend!));
    el.style.background = c;
    el.style.boxShadow = `0 0 8px ${c}`;
  });

  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(52, 1, 0.1, 1000);
  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
  renderer.setPixelRatio(Math.min(devicePixelRatio, 2));

  // Physical materials need light. Three sources: a warm key, a violet fill and
  // a cyan rim, so the facets of the solids actually read as facets.
  scene.add(new THREE.AmbientLight(0xffffff, 0.55));
  const key = new THREE.PointLight(0xffffff, 180, 200); key.position.set(18, 22, 24);
  const fill = new THREE.PointLight(0xa855f7, 120, 200); fill.position.set(-22, -8, 14);
  const rim = new THREE.PointLight(0x22d3ee, 90, 200);  rim.position.set(4, -18, -22);
  scene.add(key, fill, rim);

  /* Orbital layout. Radius falls with degree, so the most connected entities sit
     in the core — the inversion the spatial paper is about. sqrt compresses the
     long tail so the outer band does not collapse into one distant shell, and a
     per-tier vertical spread keeps shells from stacking into a flat disc. */
  const maxDeg = Math.max(...nodes.map((n) => n.deg));
  const golden = Math.PI * (3 - Math.sqrt(5));

  const placed = nodes.map((n, i) => {
    const t = Math.sqrt(1 - n.deg / maxDeg);
    const radius = 2.2 + t * 13.5;
    const y = 1 - (i / Math.max(1, nodes.length - 1)) * 2;
    const ring = Math.sqrt(Math.max(0, 1 - y * y));
    const theta = golden * i;
    const pos = new THREE.Vector3(Math.cos(theta) * ring, y * 0.75, Math.sin(theta) * ring)
      .normalize().multiplyScalar(radius);
    return { ...n, pos };
  });
  const byId = new Map(placed.map((p) => [p.id, p]));

  // Neighbour lists, so the popup can say what an entity connects to here.
  const neighbours = new Map<number, { name: string; rel: string }[]>();
  for (const e of edges) {
    const a = byId.get(e.s), b = byId.get(e.t);
    if (!a || !b) continue;
    (neighbours.get(a.id) ?? neighbours.set(a.id, []).get(a.id)!).push({ name: b.name, rel: e.rel });
    (neighbours.get(b.id) ?? neighbours.set(b.id, []).get(b.id)!).push({ name: a.name, rel: e.rel });
  }

  const edgePts: number[] = [];
  for (const e of edges) {
    const a = byId.get(e.s), b = byId.get(e.t);
    if (a && b) edgePts.push(a.pos.x, a.pos.y, a.pos.z, b.pos.x, b.pos.y, b.pos.z);
  }
  const edgeGeom = new THREE.BufferGeometry();
  edgeGeom.setAttribute('position', new THREE.Float32BufferAttribute(edgePts, 3));
  scene.add(new THREE.LineSegments(edgeGeom,
    new THREE.LineBasicMaterial({ color: 0x7c3aed, transparent: true, opacity: 0.26 })));

  /* Solids, not spheres. Following the Verse: an octahedron for the CORE tier
     and an icosahedron for everything else, with a wireframe shell over the
     core nodes so the facets are visible against the glow. */
  const group = new THREE.Group();
  scene.add(group);
  const pickable: THREE.Mesh[] = [];

  for (const p of placed) {
    const size = 0.42 + (1 - p.tier / 4) * 0.72;
    const colour = colourFor(p.type);
    const geom = p.tier === 0
      ? new THREE.OctahedronGeometry(size, 0)
      : new THREE.IcosahedronGeometry(size, 1);

    const mesh = new THREE.Mesh(geom, new THREE.MeshPhysicalMaterial({
      color: colour, emissive: colour, emissiveIntensity: 0.55 + (1 - p.tier / 4) * 0.5,
      roughness: 0.25, metalness: 0.15, transparent: true, opacity: 0.9,
    }));
    mesh.position.copy(p.pos);
    mesh.userData = p;
    group.add(mesh);
    pickable.push(mesh);

    if (p.tier === 0) {
      const wire = new THREE.Mesh(new THREE.OctahedronGeometry(size * 1.12, 0),
        new THREE.MeshBasicMaterial({ color: 0xfbbf24, wireframe: true, transparent: true, opacity: 0.45 }));
      wire.position.copy(p.pos);
      group.add(wire);
    }

    const halo = new THREE.Mesh(new THREE.SphereGeometry(size * 2.4, 16, 16),
      new THREE.MeshBasicMaterial({ color: colour, transparent: true, opacity: 0.1, depthWrite: false }));
    halo.position.copy(p.pos);
    group.add(halo);
  }

  // Selection ring, reused rather than rebuilt on every click.
  const ring = new THREE.Mesh(new THREE.RingGeometry(0.9, 1.02, 40),
    new THREE.MeshBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.75, side: THREE.DoubleSide }));
  ring.visible = false;
  scene.add(ring);

  let dragging = false, moved = 0, px = 0, py = 0;
  let yaw = 0, pitch = 0.22, dist = 30, auto = true;
  const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));

  canvas.addEventListener('pointerdown', (e) => {
    dragging = true; moved = 0; auto = false; px = e.clientX; py = e.clientY;
  });
  addEventListener('pointerup', () => { dragging = false; });
  addEventListener('pointermove', (e) => {
    if (!dragging) return;
    moved += Math.abs(e.clientX - px) + Math.abs(e.clientY - py);
    yaw += (e.clientX - px) * 0.006;
    pitch = clamp(pitch + (e.clientY - py) * 0.006, -1.2, 1.2);
    px = e.clientX; py = e.clientY;
  });
  canvas.addEventListener('wheel', (e) => {
    e.preventDefault();
    dist = clamp(dist + e.deltaY * 0.03, 8, 70);
  }, { passive: false });

  const ray = new THREE.Raycaster();
  const pointer = new THREE.Vector2();
  const pick = (e: PointerEvent | MouseEvent) => {
    const r = canvas.getBoundingClientRect();
    pointer.x = ((e.clientX - r.left) / r.width) * 2 - 1;
    pointer.y = -((e.clientY - r.top) / r.height) * 2 + 1;
    ray.setFromCamera(pointer, camera);
    return ray.intersectObjects(pickable, false)[0]?.object as THREE.Mesh | undefined;
  };

  canvas.addEventListener('pointermove', (e) => {
    const hit = pick(e);
    canvas.style.cursor = hit ? 'pointer' : 'grab';
    const d = hit?.userData as typeof placed[number] | undefined;
    hoverLabel.textContent = d ? `${d.name} — ${d.type}, ${d.deg} relationships` : '';
  });

  const TIERS = ['CORE', 'MAJOR', 'MINOR', 'PERIPHERAL', 'ISOLATED'];

  function showPopup(d: typeof placed[number]) {
    const nb = (neighbours.get(d.id) ?? []).slice(0, 8);
    popup.innerHTML = `
      <div class="flex items-start gap-2 mb-2">
        <div class="flex-1 min-w-0">
          <span class="text-[9px] uppercase tracking-[.14em]" style="color:${hex(colourFor(d.type))}">${d.type}</span>
          <div class="text-[14px] text-fg leading-snug break-words">${d.name}</div>
        </div>
        <button data-close class="text-fg-ghost hover:text-fg text-[15px] leading-none shrink-0" title="close">✕</button>
      </div>
      ${d.description ? `<p class="text-[12px] text-fg-dim m-0 mb-3">${d.description}</p>` : ''}
      <div class="grid grid-cols-3 gap-2 mb-3 text-center">
        <div><div class="text-[15px] text-fg">${d.deg}</div><div class="text-[9.5px] text-fg-ghost uppercase tracking-wider">relations</div></div>
        <div><div class="text-[15px] text-fg">${TIERS[d.tier]}</div><div class="text-[9.5px] text-fg-ghost uppercase tracking-wider">tier</div></div>
        <div><div class="text-[15px] text-fg">${d.cluster}</div><div class="text-[9.5px] text-fg-ghost uppercase tracking-wider">cluster</div></div>
      </div>
      ${nb.length ? `
        <div class="text-[9.5px] uppercase tracking-[.14em] text-fg-ghost mb-1.5">Connected here (${nb.length} of ${d.deg})</div>
        <div class="flex flex-col gap-1">
          ${nb.map((n) => `<div class="text-[11.5px] text-fg-dim flex gap-2">
            <span class="text-fg-ghost shrink-0">${n.rel}</span><span class="truncate">${n.name}</span></div>`).join('')}
        </div>` : ''}
      <div class="text-[10px] text-fg-ghost mt-3 pt-2 border-t border-line/60">
        ${d.deg - nb.length} further relationships point outside this slice.
      </div>`;
    popup.classList.remove('hidden');
    popup.querySelector('[data-close]')!.addEventListener('click', hidePopup);
  }
  const hidePopup = () => { popup.classList.add('hidden'); ring.visible = false; };

  canvas.addEventListener('click', (e) => {
    if (moved > 6) return;              // a drag is not a click
    const hit = pick(e);
    if (!hit) { hidePopup(); return; }
    const d = hit.userData as typeof placed[number];
    ring.position.copy(hit.position);
    ring.scale.setScalar((0.42 + (1 - d.tier / 4) * 0.72) * 2.1);
    ring.visible = true;
    showPopup(d);
  });

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  function resize() {
    const w = canvas.clientWidth, h = canvas.clientHeight;
    if (canvas.width !== w || canvas.height !== h) {
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    }
  }

  function frame() {
    resize();
    if (auto && !reduced) yaw += 0.0015;
    camera.position.set(
      Math.sin(yaw) * Math.cos(pitch) * dist,
      Math.sin(pitch) * dist,
      Math.cos(yaw) * Math.cos(pitch) * dist);
    camera.lookAt(0, 0, 0);
    if (ring.visible) ring.lookAt(camera.position);   // always face the viewer
    if (!reduced) group.children.forEach((c, i) => { c.rotation.y += 0.0009 + (i % 5) * 0.0002; });
    renderer.render(scene, camera);
    requestAnimationFrame(frame);
  }
  frame();
</script>
