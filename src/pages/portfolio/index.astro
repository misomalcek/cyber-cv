---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
---
<Base
  title="Portfolio — Michal Malček"
  description="Crystal RAG, SEO Brain, Symferium, and The Wisdomkeeper."
  back={{ href: base, label: 'Back to CV' }}
>
  <header class="pt-8 pb-6 border-b border-line">
    <p class="text-[15px] tracking-[.16em] uppercase text-synapse m-0 mb-2">Portfolio</p>
    <h1 class="text-[clamp(36px,5vw,56px)] leading-none font-semibold m-0 mb-3">AI portfolio</h1>
    <p class="text-fg-dim max-w-[68ch] m-0">
      Four portfolio apps — wording and figures from the CV.
    </p>
  </header>

  <Section id="apps" title="AI portfolio apps" note="4 apps">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-3">
      <article class="card p-6 flex flex-col">
        <img src={`${base}shots/crystal-rag/hero.png`} alt="Crystal RAG" loading="lazy" class="w-full h-40 object-cover rounded-lg mb-3" />
        <h3 class="text-[22px] font-semibold m-0 mb-2 text-fg">Crystal RAG</h3>
        <p class="text-[17.5px] text-fg-dim m-0 mb-4 flex-1 leading-snug">
          Crystal RAG is a desktop RAG app (Tauri, Rust, Three.js) with Qdrant and the embedding model shipped inside.
          Hybrid retrieval fuses vector, lexical and graph search with RRF (reciprocal rank fusion).
        </p>
        <p class="flex flex-wrap gap-x-4 gap-y-2 m-0 text-[16px]">
          <a href={`${base}portfolio/crystal-rag/`}>Details and screenshots</a>
          <a href="https://github.com/misomalcek/crystal-rag">Repository</a>
          <a href="https://misomalcek.github.io/crystal-rag/">Project page</a>
        </p>
      </article>

      <article class="card p-6 flex flex-col">
        <img src={`${base}shots/seo-brain/hero.png`} alt="SEO Brain" loading="lazy" class="w-full h-40 object-cover rounded-lg mb-3" />
        <h3 class="text-[22px] font-semibold m-0 mb-2 text-fg">SEO Brain</h3>
        <p class="text-[17.5px] text-fg-dim m-0 mb-4 flex-1 leading-snug">
          SEO Brain is a multi-agent SEO and content platform (TypeScript, Python, Anthropic SDK, PostgreSQL, Apache AGE).
          One codebase deploys to a VPS, a cloud instance, or a macOS or Windows app.
        </p>
        <p class="flex flex-wrap gap-x-4 gap-y-2 m-0 text-[16px]">
          <a href={`${base}portfolio/seo-brain/`}>Details and screenshots</a>
          <a href="https://github.com/misomalcek/seo-brain">Repository</a>
        </p>
      </article>

      <article class="card p-6 flex flex-col">
        <img src={`${base}shots/symferium/hero.png`} alt="Symferium" loading="lazy" class="w-full h-40 object-cover rounded-lg mb-3" />
        <h3 class="text-[22px] font-semibold m-0 mb-2 text-fg">Symferium</h3>
        <p class="text-[17.5px] text-fg-dim m-0 mb-4 flex-1 leading-snug">
          Symferium is a local multi-model AI runtime for Apple Silicon: one Rust daemon picks the engine, watches the memory budget, and serves a browser UI plus an agent API.
        </p>
        <p class="flex flex-wrap gap-x-4 gap-y-2 m-0 text-[16px]">
          <a href={`${base}portfolio/symferium/`}>Details and screenshots</a>
          <a href="https://github.com/misomalcek/symferium/">Repository</a>
        </p>
      </article>

      <article class="card p-6 flex flex-col">
        <img src={`${base}shots/wisdomkeeper/hero.png`} alt="The Wisdomkeeper" loading="lazy" class="w-full h-40 object-cover rounded-lg mb-3" />
        <h3 class="text-[22px] font-semibold m-0 mb-2 text-fg">The Wisdomkeeper</h3>
        <p class="text-[17.5px] text-fg-dim m-0 mb-4 flex-1 leading-snug">
          The Wisdomkeeper is a 3D open-world AI game with a custom Rust inference runtime (2,841 lines) over llama.cpp.
          A log-probability judge and grammar-constrained decoding keep the procedural text coherent.
        </p>
        <p class="flex flex-wrap gap-x-4 gap-y-2 m-0 text-[16px]">
          <a href={`${base}portfolio/wisdomkeeper/`}>Details and screenshots</a>
          <a href="https://github.com/misomalcek/the-wisdomkeeper/">Repository</a>
          <a href="https://misomalcek.github.io/the-wisdomkeeper/">Play online</a>
        </p>
      </article>
    </div>
  </Section>

  <Section id="magazines" title="AI-managed magazines" note="2 sites">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      <a href="https://alteranai.com/" class="card p-5 no-underline flex flex-col group">
        <h3 class="text-[22px] m-0 text-fg group-hover:text-synapse transition-colors">alteranai.com</h3>
        <p class="text-[17.5px] text-fg-dim m-0 mt-2">AI engineering magazine in English.</p>
        <span class="text-[17px] text-synapse mt-3">Visit →</span>
      </a>
      <a href="https://aisvet.sk/" class="card p-5 no-underline flex flex-col group">
        <h3 class="text-[22px] m-0 text-fg group-hover:text-synapse transition-colors">aisvet.sk</h3>
        <p class="text-[17.5px] text-fg-dim m-0 mt-2">AI magazine in Slovak, Cloudflare AI Search chat.</p>
        <span class="text-[17px] text-synapse mt-3">Visit →</span>
      </a>
    </div>
  </Section>

  <Section id="production" title="Production systems" note="2 systems">
    <p class="text-[17.5px] text-fg-dim m-0">
      Team Brain and Factorium, with results: <a href={`${base}production/`}>Production →</a>
    </p>
  </Section>
</Base>
