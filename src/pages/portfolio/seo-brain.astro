---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
---
<Base
  title="seo-brain — Michal Malček"
  description="seo-brain"
  back={{ href: `${base}portfolio/`, label: 'portfolio' }}
>
  <header class="pt-10 pb-8 border-b border-line">
    <h1 class="text-[clamp(35px,4.8vw,52px)] font-semibold tracking-tight m-0 mb-3">seo-brain</h1>
    <p class="lede m-0">Details coming soon.</p>
  </header>
</Base>
