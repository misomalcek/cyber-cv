---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Credential from '../../components/Credential.astro';

/* Link states were checked with an HTTP probe on 2026-08-14, not assumed.
   Five Google Drive documents returned HTTP 200 that were actually the Drive
   sign-in page — a recruiter clicking them would have hit a login wall. Those
   are marked 'hosted' and served from this site instead. */

const education = [
  {
    title: 'Applied Informatics — Bachelor\'s degree',
    issuer: 'University of Economics, Prague',
    when: '2006 – 2009',
    detail: 'Average grade <b>1.6</b> · top 10 student of ~500 in the 2006/07 year · excellent marks for the state exam and the thesis. Systems theory, databases and enterprise systems under the field\'s leading Czech professors.',
    state: 'hosted' as const,
  },
  {
    title: 'Information Systems & Technologies — Master\'s, 41 ECTS',
    issuer: 'University of Economics, Prague',
    when: '2009 – 2011',
    detail: 'Average grade <b>1.5</b>. Left for practice rather than finishing the degree.',
    state: 'hosted' as const,
  },
  {
    title: 'CEMS International Management — Master\'s, taught in English',
    issuer: 'CEMS · University of Economics, Prague',
    when: '2009 – 2011',
    detail: 'Average grade <b>1.7</b>. All mandatory courses and skill seminars completed; the second business-language exam (Russian) not passed.',
    href: 'https://www.cems.org/',
    state: 'live' as const,
  },
  {
    title: 'Erasmus exchange — A grade in every subject',
    issuer: 'Corvinus University, Budapest',
    when: 'Spring 2010',
    detail: 'Business project with GE Money Bank: developing micro customers with online tools.',
    href: 'http://www.uni-corvinus.hu/index.php?id=44542',
    state: 'live' as const,
  },
  {
    title: 'Electrical Engineering, specialisation ICT',
    issuer: 'High School of Jozef Murgaš, Banská Bystrica',
    when: '2002 – 2006',
    detail: 'Final-year average <b>1.0</b> · honourable mention in the school\'s 90th anniversary book.',
    state: 'gone' as const,
  },
  {
    title: 'Startup Scholarship, Lisbon',
    issuer: 'Summer school at Startup Lisboa',
    when: 'Jul – Aug 2013',
    detail: 'University and business courses in practice among startups.',
    href: 'https://www.facebook.com/TheStartupScholarship/',
    state: 'live' as const,
  },
];

const certificates = [
  {
    title: 'AI Generalist',
    issuer: 'Outskill — three-day intensive',
    when: 'January 2026',
    detail: 'The only formal AI training I have. It pointed me at the landscape; everything after came from the systems.',
    state: 'none' as const,
  },
  {
    title: 'International language competition — 3rd place',
    issuer: 'Russian language',
    when: 'Secondary school',
    href: 'https://drive.google.com/file/d/1CO4XJdY4kGTINsHSgpdxJW88-kZfiw44/view',
    state: 'live' as const,
  },
  {
    title: 'German A1',
    issuer: 'Goethe-Institut',
    when: '2020',
    href: 'https://drive.google.com/file/d/1EFfwV0IBUwD3-zxCEKRi03ynCC8C9ksL/view',
    state: 'live' as const,
  },
  {
    title: 'Google AdWords & Analytics — all four certificates',
    issuer: 'Google internal examinations',
    when: '2010 – 2011',
    detail: 'Verified through the Google Testing Center, which no longer exists.',
    state: 'gone' as const,
  },
  {
    title: 'Google internal training programme',
    issuer: 'Google',
    when: '2010 – 2011',
    detail: 'AdWords Professional, Analytics, Product Management, Coding in Python, Personal Effectiveness, Presenting with Confidence.',
    state: 'none' as const,
  },
  {
    title: 'StepUp management programme — 10 weeks',
    issuer: 'Lottoland',
    when: '2017',
    state: 'none' as const,
  },
];

const speaking = [
  {
    title: 'Speaker — Slovak e-commerce conference',
    issuer: 'Recorded session',
    when: '2013',
    href: 'https://www.youtube.com/watch?v=f8WMaL8jWYg',
    state: 'live' as const,
  },
  {
    title: 'Four AI workshops for an entire company branch',
    issuer: 'msg life Slovakia · leadership to newest hires, voluntary attendance',
    when: '2025 – 2026',
    detail: 'The first opened with ethics and the practical limits of formal logic — Gödel, the frame problem, Tarski — and what each means when working with a probabilistic system.',
    state: 'none' as const,
  },
  {
    title: 'Participant — SiGMA Malta',
    issuer: 'Malta iGaming Summit',
    when: '2018',
    state: 'none' as const,
  },
];
---
<Base
  title="Credentials — Michal Malček"
  description="Diplomas, certificates and references, with the state of every source link checked rather than assumed."
  back={{ href: '/', label: 'Back to CV' }}
>
  <header class="pt-10 pb-8 border-b border-line">
    <h1 class="text-[clamp(28px,4vw,40px)] font-semibold tracking-tight m-0 mb-3">Credentials</h1>
    <p class="text-fg-dim max-w-[660px] m-0">
      Every source link here was probed on 2026-08-14 rather than assumed to work. Five documents
      returned a Google sign-in page instead of the file, so they are served from this site
      directly; three original pages have gone offline in the years since, and say so.
    </p>
    <div class="flex flex-wrap gap-4 mt-5 text-[12px] text-fg-ghost">
      {[
        ['border-synapse/40 text-synapse', 'source', 'external link, checked and working'],
        ['border-neural/40 text-neural', 'document', 'copy served from this site'],
        ['border-line', 'link n/a', 'original page offline; record held'],
      ].map(([cls, label, meaning]) => (
        <span class="inline-flex items-center gap-2">
          <span class={`text-[10px] uppercase tracking-wider border rounded px-1.5 py-0.5 ${cls}`}>{label}</span>
          {meaning}
        </span>
      ))}
    </div>
  </header>

  <Section title="Education" note={`${education.length} records`}>
    <div class="grid md:grid-cols-2 gap-3">
      {education.map((c) => <Credential {...c} />)}
    </div>
  </Section>

  <Section title="Certificates & training" note={`${certificates.length} records`}>
    <div class="grid md:grid-cols-2 gap-3">
      {certificates.map((c) => <Credential {...c} />)}
    </div>
  </Section>

  <Section title="Speaking & teaching" note={`${speaking.length} records`}>
    <div class="grid md:grid-cols-2 gap-3">
      {speaking.map((c) => <Credential {...c} />)}
    </div>
  </Section>

  <Section title="References">
    <div class="card p-5">
      <p class="text-fg-dim m-0 text-[14px]">
        Available on request, from every role listed on the CV. I would rather introduce you to
        someone who worked with me directly than publish contact details for people who did not
        ask to be listed.
      </p>
    </div>
  </Section>
</Base>
