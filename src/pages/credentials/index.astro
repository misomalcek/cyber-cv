---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import { refsOrdered } from '../../data/refs';

/**
 * One list. Fifteen rows, one line each, oldest first.
 *
 * The previous version carried every qualification twice — a register of the
 * files plus a parallel set of cards with a paragraph of commentary on each.
 * A credential is a fact, a date and a document; the commentary was mine to add
 * and nobody asked for it.
 */
---
<Base
  title="Credentials — Michal Malček"
  description="Fifteen documents, held in this repository and opened here."
  back={{ href: `${base}`, label: 'Back to CV' }}
>
  <header class="pt-10 pb-7 border-b border-line">
    <h1 class="text-[clamp(30px,4.4vw,44px)] font-semibold tracking-tight m-0 mb-3">Credentials</h1>
    <p class="lede m-0">
      Every document is in this repository and opens on this page — no sign-in, no dead links.
      Numbered so other pages can cite one as <span class="text-synapse">[n]</span>.
    </p>
  </header>

  <Section title="Documents" note={`${refsOrdered.length}`}>
    <ol class="list-none p-0 m-0 flex flex-col">
      {refsOrdered.map((r) => (
        <li id={`r-${r.n}`} class="scroll-mt-24 border-b border-line/40 last:border-b-0">
          {r.files ? (
            <button type="button" class="ref-row w-full text-left flex items-baseline gap-3 py-3"
                    data-ref={r.n} data-files={r.files.join('|')} data-title={r.title}>
              <span class="ref-num shrink-0">{r.n}</span>
              <span class="flex-1 min-w-0">
                <b class="text-[15px] text-fg font-semibold">{r.title}</b>
                <span class="block text-[13px] text-fg-ghost mt-0.5">
                  {r.issuer} · {r.date}{r.note ? ` · ${r.note}` : ''}
                </span>
              </span>
              <span class="shrink-0 text-[12.5px] text-synapse whitespace-nowrap">
                {r.files.length > 1 ? `${r.files.length} pages` : 'open'} →
              </span>
            </button>
          ) : (
            <div class="flex items-baseline gap-3 py-3">
              <span class="ref-num shrink-0">{r.n}</span>
              <span class="flex-1 min-w-0">
                <b class="text-[15px] text-fg font-semibold">{r.title}</b>
                <span class="block text-[13px] text-fg-ghost mt-0.5">
                  {r.issuer} · {r.date}{r.note ? ` · ${r.note}` : ''}
                </span>
              </span>
              {r.link && (
                <a href={r.link} target="_blank" rel="noopener"
                   class="shrink-0 text-[12.5px] text-synapse no-underline whitespace-nowrap">source →</a>
              )}
            </div>
          )}
        </li>
      ))}
    </ol>
  </Section>

  <!-- The one reference worth quoting, because of what it is about rather than
       who signed it. -->
  <Section title="Reference — Google, 2011">
    <div class="card p-5">
      <blockquote class="m-0 pl-4 border-l-2 border-neural/40 text-[14px] text-fg-dim">
        <p class="m-0 mb-2">
          "Just wanted to thank you for all the great work you've done on the verticalization
          research… <b class="text-fg">I've also asked a few of our engineers to look at improving
          vertical quality</b> as well."
        </p>
        <p class="m-0 text-[12.5px] text-fg-ghost">
          — Andrew Nartker, Product Manager, Ads Revenue &amp; Reporting, Google · 19 Sept 2011
          · <a href={`${base}credentials/#r-11`} class="text-synapse no-underline hover:underline">document [11]</a>
        </p>
      </blockquote>
      <p class="text-[13.5px] text-fg-dim mt-4 m-0">
        I was 24 and the assignment was to categorise several thousand AdWords clients by hand
        over a summer. I wrote formulas and a small script that derived most of it from the web
        address — two weeks instead of three months — and spent the time left looking at what the
        verticals were actually doing. <b class="text-fg">That is the research the email is
        about: an intern's spare time, created by refusing to do the work manually, put engineers
        on a quality problem.</b>
      </p>
    </div>
  </Section>

  <!-- Document viewer: one dialog reused for every reference. -->
  <div id="doc-viewer" class="hidden fixed inset-0 z-50 items-center justify-center p-4 sm:p-8"
       role="dialog" aria-modal="true" aria-labelledby="doc-title">
    <div id="doc-backdrop" class="absolute inset-0 bg-black/80" style="backdrop-filter: blur(6px)"></div>
    <div class="relative card w-full max-w-[980px] max-h-[92vh] flex flex-col overflow-hidden">
      <div class="flex items-center gap-3 p-4 border-b border-line shrink-0">
        <span id="doc-num" class="ref-num shrink-0"></span>
        <b id="doc-title" class="text-[15px] text-fg flex-1 min-w-0 truncate"></b>
        <span id="doc-pager" class="text-[12.5px] text-fg-ghost whitespace-nowrap"></span>
        <button id="doc-prev" type="button" class="chip" aria-label="Previous page">‹</button>
        <button id="doc-next" type="button" class="chip" aria-label="Next page">›</button>
        <a id="doc-open" href="#" target="_blank" rel="noopener" class="chip no-underline">open file</a>
        <button id="doc-close" type="button" class="chip" aria-label="Close">✕ esc</button>
      </div>
      <div id="doc-body" class="flex-1 overflow-auto bg-black/25 p-3 flex items-start justify-center"></div>
    </div>
  </div>
</Base>

<script>
  /**
   * Document viewer. PDFs in an <object>, images in an <img>; multi-page
   * documents page with the arrows or the keyboard. /credentials/#r-3 opens
   * reference 3 directly, which is what makes a citation land somewhere.
   */
  const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
  const viewer = document.getElementById('doc-viewer')!;
  const body = document.getElementById('doc-body')!;
  const titleEl = document.getElementById('doc-title')!;
  const numEl = document.getElementById('doc-num')!;
  const pager = document.getElementById('doc-pager')!;
  const openLink = document.getElementById('doc-open') as HTMLAnchorElement;
  const prev = document.getElementById('doc-prev')!;
  const next = document.getElementById('doc-next')!;

  let files: string[] = [];
  let page = 0;

  function render() {
    const f = files[page];
    if (!f) return;
    const url = `${base}refs/${f}`;
    openLink.href = url;
    pager.textContent = files.length > 1 ? `${page + 1} / ${files.length}` : '';
    prev.classList.toggle('hidden', files.length < 2);
    next.classList.toggle('hidden', files.length < 2);
    body.innerHTML = f.toLowerCase().endsWith('.pdf')
      ? `<object data="${url}" type="application/pdf" class="w-full h-[76vh] rounded-lg">
           <p class="p-6 text-fg-dim text-[13px]">This browser will not display the PDF inline.
             <a href="${url}" target="_blank" rel="noopener" class="text-synapse">Open it in a new tab</a>.</p>
         </object>`
      : `<img src="${url}" alt="" class="max-w-full h-auto rounded-lg" />`;
  }

  function open(n: number) {
    const btn = document.querySelector<HTMLButtonElement>(`[data-ref="${n}"]`);
    if (!btn) return;
    files = (btn.dataset.files || '').split('|').filter(Boolean);
    page = 0;
    numEl.textContent = String(n);
    titleEl.textContent = btn.dataset.title || '';
    viewer.classList.remove('hidden');
    viewer.classList.add('flex');
    document.body.style.overflow = 'hidden';
    render();
  }

  function close() {
    viewer.classList.add('hidden');
    viewer.classList.remove('flex');
    body.innerHTML = '';
    document.body.style.overflow = '';
  }

  document.querySelectorAll<HTMLButtonElement>('[data-ref]').forEach((b) =>
    b.addEventListener('click', () => open(Number(b.dataset.ref))));
  document.getElementById('doc-close')!.addEventListener('click', close);
  document.getElementById('doc-backdrop')!.addEventListener('click', close);
  prev.addEventListener('click', () => { page = (page - 1 + files.length) % files.length; render(); });
  next.addEventListener('click', () => { page = (page + 1) % files.length; render(); });

  addEventListener('keydown', (e) => {
    if (viewer.classList.contains('hidden')) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft' && files.length > 1) { page = (page - 1 + files.length) % files.length; render(); }
    if (e.key === 'ArrowRight' && files.length > 1) { page = (page + 1) % files.length; render(); }
  });

  const fromHash = () => {
    const m = location.hash.match(/^#r-(\d+)$/);
    if (m) open(Number(m[1]));
  };
  fromHash();
  addEventListener('hashchange', fromHash);
</script>

<style>
  .ref-num {
    display: inline-flex; align-items: center; justify-content: center;
    width: 26px; height: 26px; border-radius: 8px;
    font-size: 12.5px; font-weight: 700; font-variant-numeric: tabular-nums;
    color: var(--color-synapse);
    background: color-mix(in srgb, var(--color-neural) 16%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-neural) 38%, transparent);
  }
  .ref-row { cursor: pointer; transition: background .18s; }
  .ref-row:hover { background: color-mix(in srgb, var(--color-neural) 7%, transparent); }
</style>
