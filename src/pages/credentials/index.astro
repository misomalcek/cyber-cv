---
// Astro returns BASE_URL without a trailing slash at the root but with one
// under a subpath; normalise so `${base}x` is never `/cyber-cvx`.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import { refsOrdered, isPdf } from '../../data/refs';
import Credential from '../../components/Credential.astro';

/* Link states were checked with an HTTP probe on 2026-08-14.
   The old CV's Drive URLs use the pre-2021 `open?id=` form without a
   `resourcekey`, which Google now answers with a sign-in page even for public
   files. With the current URLs the documents are public and load — one exception
   is noted below. Probe the titles, not the status code: a Drive login page
   returns a perfectly healthy 200. */

const education = [
  {
    title: 'Applied Informatics — Bachelor\'s degree',
    issuer: 'University of Economics, Prague',
    when: '2006 – 2009',
    detail: 'Average grade <b>1.6</b> · excellent marks for the state exam and the thesis. Systems theory, databases and enterprise systems under the field\'s leading Czech professors. The thesis was defended with full marks and no objections.',
    href: 'https://drive.google.com/file/d/0B46PEjkLM1N3aklicUxuQXBhaW8/view?resourcekey=0-CnU0vgjMFyLSwBIMd5Y_IQ',
    state: 'live' as const,
  },
  {
    title: 'Top 10 student of ~500 — official ranking',
    issuer: 'University of Economics, Prague · 2006/07',
    when: '2007',
    detail: 'Published faculty ranking for the year.',
    href: 'https://drive.google.com/file/d/0B46PEjkLM1N3dW1rU3ZaSDY3alU/view?resourcekey=0-MTnIUdonwu21cGX1MaXHqg',
    state: 'live' as const,
  },
  {
    title: 'Information Systems & Technologies — Master\'s, 41 ECTS',
    issuer: 'University of Economics, Prague',
    when: '2009 – 2011',
    detail: 'Average grade <b>1.5</b>. Took the subjects that interested me, then left for practice rather than finishing the degree.',
    state: 'none' as const,
  },
  {
    title: 'CEMS International Management — Master\'s, taught in English',
    issuer: 'CEMS · University of Economics, Prague',
    when: '2009 – 2011',
    detail: 'Average grade <b>1.7</b>. All mandatory courses and skill seminars completed; the second business-language exam (Russian) not passed.',
    href: 'https://docs.google.com/file/d/0B46PEjkLM1N3RmZha2RwOTc0Wkk/edit?resourcekey=0-vNu9k-AplsTRjvNZzBuZ2w',
    state: 'live' as const,
  },
  {
    title: 'CEMS programme — detailed overview',
    issuer: 'CEMS · The Global Alliance in Management Education',
    when: '2009 – 2011',
    detail: 'What the programme covers, for context on the grade above.',
    href: 'https://drive.google.com/file/d/0B46PEjkLM1N3WDBfX2tYcFp3YVE/view?resourcekey=0-qfqzWvcSgTNXPf_N6DIihg',
    state: 'live' as const,
  },
  {
    title: 'Erasmus exchange — A grade in every subject',
    issuer: 'Corvinus University, Budapest',
    when: 'Spring 2010',
    detail: 'Business project with GE Money Bank: developing micro customers with online tools.',
    href: 'http://www.uni-corvinus.hu/index.php?id=44542',
    state: 'live' as const,
  },
  {
    title: 'Electrical Engineering, specialisation ICT',
    issuer: 'High School of Jozef Murgaš, Banská Bystrica',
    when: '2002 – 2006',
    detail: 'Final-year average <b>1.0</b>. A hundred years old and the country\'s leading technical secondary school. My honourable mention in the 90th anniversary book was four pages of poetry that had won a regional competition — which, in a school full of engineers, restarted an interest in writing that nobody expected to find there.',
    state: 'none' as const,
  },
  {
    title: 'Startup Scholarship, Lisbon',
    issuer: 'Summer school at Startup Lisboa',
    when: 'Jul – Aug 2013',
    detail: 'University and business courses in practice among startups. Selected as an outstanding student and future entrepreneur.',
    href: 'https://www.facebook.com/TheStartupScholarship/',
    state: 'live' as const,
  },
];

const certificates = [
  {
    title: 'AI Generalist',
    issuer: 'Outskill — three-day intensive',
    when: 'January 2026',
    detail: 'The only formal AI training I have. It pointed me at the landscape; everything after came from the systems.',
    state: 'none' as const,
  },
  {
    title: 'Third worldwide — international Russian language olympiad',
    issuer: 'St Petersburg University · 5,000+ entrants, non-native speakers',
    when: '2022',
    detail: 'Finished third by a margin of a few tenths of a percent. Entered the year the war started — <span class="text-fg-dim">a language is not the state that speaks it, and refusing to learn one has never disarmed anybody.</span> The Slovak side never issued the physical certificate; the confirmation email is the record.',
    href: 'https://drive.google.com/file/d/1CO4XJdY4kGTINsHSgpdxJW88-kZfiw44/view',
    state: 'live' as const,
  },
  {
    title: 'German A1',
    issuer: 'Goethe-Institut, Hamburg',
    when: '2020',
    detail: 'Taken while working in the German market, in Germany.',
    href: 'https://drive.google.com/file/d/1EFfwV0IBUwD3-zxCEKRi03ynCC8C9ksL/view',
    state: 'live' as const,
  },
  {
    title: 'Google AdWords & Analytics — all four certificates',
    issuer: 'Google internal examinations',
    when: '2010 – 2011',
    detail: 'Verified through the Google Testing Center, which was retired years ago — the link in my old CV now resolves to an error page. What survives is the Certification Program account confirmation.',
    href: `${base}credentials/google-certification-2011.pdf`,
    state: 'hosted' as const,
  },
  {
    title: 'Google internal training programme',
    issuer: 'Google',
    when: '2010 – 2011',
    detail: 'AdWords Professional, Analytics, Product Management, Coding in Python, Personal Effectiveness, Presenting with Confidence.',
    state: 'none' as const,
  },
  {
    title: 'StepUp management programme — 10 weeks',
    issuer: 'Lottoland',
    when: '2017',
    state: 'none' as const,
  },
];

const research_profile = [
  {
    title: 'Academia.edu — 13,270 public views across 14 papers',
    issuer: 'University of Economics, Prague · Department of Information Technologies',
    when: 'uploaded once as a student; never maintained since',
    detail: 'Coursework, uploaded once around 2011 and never maintained. <b>577 followers</b>, <b>221 papers mentioning the name</b>, and a readership that is still arriving — most of it from the United States, India, the United Kingdom, Malaysia and Germany.',
    href: 'https://ekonomka.academia.edu/MichalMalcek',
    state: 'live' as const,
  },
];

const speaking = [
  {
    title: 'Speaker — Slovak e-commerce conference',
    issuer: 'Recorded session',
    when: '2013',
    href: 'https://www.youtube.com/watch?v=f8WMaL8jWYg',
    state: 'live' as const,
  },
  {
    title: 'Four AI workshops for an entire company branch',
    issuer: 'msg life Slovakia · leadership to newest hires, voluntary attendance',
    when: '2025 – 2026',
    detail: 'The first opened with ethics and the practical limits of formal logic — Gödel, the frame problem, Tarski — and what each means when working with a probabilistic system.',
    state: 'none' as const,
  },
  {
    title: 'Participant — SiGMA Malta',
    issuer: 'Malta iGaming Summit',
    when: '2018',
    state: 'none' as const,
  },
];
---
<Base
  title="Credentials & references — Michal Malček"
  description="Every diploma, certificate and reference, held in this repository and opened here — no sign-in, no dead links."
  back={{ href: `${base}`, label: 'Back to CV' }}
>
  <header class="pt-10 pb-8 border-b border-line">
    <h1 class="text-[clamp(30px,4.4vw,44px)] font-semibold tracking-tight m-0 mb-3">Credentials &amp; references</h1>
    <p class="lede m-0">
      Every document below is <b class="text-fg">in this repository</b> and opens on this page.
      The previous version linked to a drive, and four of those links asked a stranger to sign in —
      which makes a reference unverifiable at exactly the moment it matters. They are numbered so
      other pages can cite one as <span class="text-synapse">[n]</span>.
    </p>
  </header>

  <!-- ── The register ─────────────────────────────────────────────────────
       Numbered, oldest first. Each row opens its file(s) in the viewer below;
       PDFs render in an <object>, images as <img>. Nothing leaves the site. -->
  <Section id="register" title="Reference register"
           note={`${refsOrdered.length} documents`}
           lede="Chronological. Click any row to open the document — everything is served from this repository.">
    <ol class="list-none p-0 m-0 flex flex-col gap-2">
      {refsOrdered.map((r) => (
        <li id={`r-${r.n}`} class="scroll-mt-24">
          <button type="button" class="ref-row card w-full text-left p-4 flex items-start gap-4"
                  data-ref={r.n}
                  data-files={r.files.join('|')}
                  data-title={r.title}>
            <span class="ref-num shrink-0">{r.n}</span>
            <span class="flex-1 min-w-0">
              <span class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-1">
                <b class="text-[15.5px] text-fg font-semibold">{r.title}</b>
                <span class="text-[11px] uppercase tracking-wider text-fg-ghost border border-line rounded px-1.5 py-0.5">{r.kind}</span>
              </span>
              <span class="block text-[13.5px] text-fg-dim">{r.issuer} · {r.date}</span>
              {r.note && <span class="block text-[13px] text-fg-ghost mt-1.5">{r.note}</span>}
            </span>
            <span class="shrink-0 text-[12.5px] text-synapse self-center whitespace-nowrap">
              {r.files.length > 1 ? `${r.files.length} pages` : 'open'} →
            </span>
          </button>
        </li>
      ))}
    </ol>
  </Section>

  <!-- Document viewer: one dialog reused for every reference. -->
  <div id="doc-viewer" class="hidden fixed inset-0 z-50 items-center justify-center p-4 sm:p-8"
       role="dialog" aria-modal="true" aria-labelledby="doc-title">
    <div id="doc-backdrop" class="absolute inset-0 bg-black/80" style="backdrop-filter: blur(6px)"></div>
    <div class="relative card w-full max-w-[980px] max-h-[92vh] flex flex-col overflow-hidden">
      <div class="flex items-center gap-3 p-4 border-b border-line shrink-0">
        <span id="doc-num" class="ref-num shrink-0"></span>
        <b id="doc-title" class="text-[15px] text-fg flex-1 min-w-0 truncate"></b>
        <span id="doc-pager" class="text-[12.5px] text-fg-ghost whitespace-nowrap"></span>
        <button id="doc-prev" type="button" class="chip" aria-label="Previous page">‹</button>
        <button id="doc-next" type="button" class="chip" aria-label="Next page">›</button>
        <a id="doc-open" href="#" target="_blank" rel="noopener" class="chip no-underline">open file</a>
        <button id="doc-close" type="button" class="chip" aria-label="Close">✕ esc</button>
      </div>
      <div id="doc-body" class="flex-1 overflow-auto bg-black/25 p-3 flex items-start justify-center"></div>
    </div>
  </div>

  <Section title="Education" note={`${education.length} records`}>
    <div class="grid md:grid-cols-2 gap-3">
      {education.map((c) => <Credential {...c} />)}
    </div>
  </Section>

  <Section title="Certificates & training" note={`${certificates.length} records`}>
    <div class="grid md:grid-cols-2 gap-3">
      {certificates.map((c) => <Credential {...c} />)}
    </div>
  </Section>

  <Section title="Speaking & teaching" note={`${speaking.length} records`}>
    <div class="grid md:grid-cols-2 gap-3">
      {speaking.map((c) => <Credential {...c} />)}
    </div>
  </Section>

  <Section title="Research profile" note="the one external record">
    <div class="grid md:grid-cols-2 gap-3 mb-4">
      {research_profile.map((c) => <Credential {...c} />)}
    </div>

    <div class="card p-5">
      <div class="eyebrow mb-3">A footnote worth keeping</div>
      <div class="grid sm:grid-cols-4 gap-4 mb-5">
        {[
          ['13,270', 'public views'],
          ['221', 'papers mentioning the name'],
          ['577', 'followers'],
          ['1,607', 'downloads'],
        ].map(([v, l]) => (
          <div>
            <div class="text-[21px] font-semibold lit-forge leading-none">{v}</div>
            <div class="text-[11px] text-fg-ghost mt-1.5">{l}</div>
          </div>
        ))}
      </div>

      <div class="grid md:grid-cols-[1.35fr_1fr] gap-6 mb-5">
        <div>
          <div class="text-[10.5px] tracking-[.14em] uppercase text-fg-ghost mb-3">The papers</div>
          <div class="flex flex-col gap-1.5">
            {[
              ['Adidas, Nike, Puma — financial analysis', '10,168', '1,107'],
              ['Japanese business culture and business ethics', '2,031', '246'],
              ['Community marketing — B2B, B2C', '525', '139'],
              ['Leadership traits and styles', '201', '81'],
              ['Vegetarians as a subculture: values and brands', '170', '13'],
              ['European Student Finance Portal', '50', '21'],
            ].map(([title, views, dl]) => (
              <div class="grid grid-cols-[1fr_62px_54px] gap-2 items-baseline text-[12.5px] py-1
                          border-b border-line/40 last:border-b-0">
                <span class="text-fg-dim">{title}</span>
                <span class="text-fg tabular-nums text-right">{views}</span>
                <span class="text-fg-ghost tabular-nums text-right">{dl}</span>
              </div>
            ))}
          </div>
          <div class="text-[10.5px] text-fg-ghost mt-2">views · downloads</div>
        </div>

        <div>
          <div class="text-[10.5px] tracking-[.14em] uppercase text-fg-ghost mb-3">Where it is read</div>
          <div class="flex flex-col gap-2">
            {[
              ['United States', 2156, 100],
              ['India', 1161, 54],
              ['United Kingdom', 885, 41],
              ['Malaysia', 745, 35],
              ['Germany', 431, 20],
            ].map(([c, n, pct]) => (
              <div class="grid grid-cols-[110px_1fr_44px] gap-2 items-center text-[12px]">
                <span class="text-fg-dim truncate">{c}</span>
                <span class="block h-[5px] rounded-full overflow-hidden"
                      style="background: color-mix(in srgb, var(--color-line) 55%, transparent)">
                  <span class="block h-full rounded-full"
                        style={`width:${pct}%;
                                background: linear-gradient(90deg, var(--color-neural), var(--color-synapse));
                                box-shadow: 0 0 8px color-mix(in srgb, var(--color-neural) 60%, transparent)`} />
                </span>
                <span class="text-fg-ghost tabular-nums text-right">{n.toLocaleString('en-US')}</span>
              </div>
            ))}
          </div>
          <div class="text-[10.5px] text-fg-ghost mt-2">all-time views by country</div>
        </div>
      </div>

      <p class="text-[13px] text-fg-dim m-0 mb-2">
        None of this is AI work. It is undergraduate coursework — a financial analysis of three
        sportswear companies, a paper on Japanese business ethics — uploaded around 2011 and never
        touched again.
      </p>
      <p class="text-[12.5px] text-fg-ghost m-0">
        It is here for one reason: <b class="text-fg-dim">it is the only long-run measurement I have
        of anything I wrote reaching strangers</b>, and it ran for fifteen years without any
        maintenance from me. The counter moved twice while this page was being written.
      </p>
    </div>
  </Section>

  <Section title="References">
    <div class="card p-5 mb-3">
      <div class="flex items-baseline justify-between gap-3 flex-wrap mb-3">
        <div class="eyebrow">Google, 2011 — the one I kept</div>
        <a href={`${base}credentials/google-nartker-2011.pdf`}
           class="text-[11.5px] no-underline hover:underline shrink-0">Original email (PDF) →</a>
      </div>
      <blockquote class="m-0 pl-4 border-l-2 border-neural/40 text-[13.5px] text-fg-dim">
        <p class="m-0 mb-2">
          "Just wanted to thank you for all the great work you've done on the verticalization
          research. I'll take the actions to follow-up on your leads, and separately you'll be
          happy to know that <b class="text-fg">I've also asked a few of our engineers to look at
          improving vertical quality</b> as well. We'll see what we can find."
        </p>
        <p class="m-0 text-[12.5px] text-fg-ghost">
          — Andrew Nartker, Product Manager, Ads Revenue &amp; Reporting, Google · 19 September 2011
        </p>
      </blockquote>
      <p class="text-[12.5px] text-fg-dim mt-3 mb-2">
        I was 24, on a three-month associate programme, and the assignment was to spend the summer
        categorising AdWords clients by hand in a spreadsheet. I did not want to retype several
        thousand rows, so I worked out formulas and a small script that derived most of the category
        from the web address. That took two weeks. Then I was bored, so I looked at what the
        verticals themselves were doing — <b class="text-fg">and that is the research the email is
        about.</b>
      </p>
      <p class="text-[12.5px] text-fg-ghost m-0">
        The part worth keeping is not the thanks: it is that work done by an intern, in time freed
        up by refusing to do it manually, put engineers on a quality problem. Fifteen years later I
        am still doing the same thing — the tools changed, the reflex did not. Phone number and
        email redacted in the attachment; the name and role were public, the contact details were
        not mine to publish.
      </p>
    </div>

    <div class="card p-5">
      <div class="eyebrow mb-3">Current, on request</div>
      <p class="text-fg-dim m-0 text-[14px] mb-3">
        The relevant recent reference is <b class="text-fg">msg life Slovakia</b>, where Team Brain
        was built, used and handed over — and where the colleague who took over its administration
        can speak to what it does in daily use.
      </p>
      <p class="text-[12.5px] text-fg-ghost m-0">
        Contacts on request rather than published here: people who did not ask to be listed on a
        public page should not find themselves on one.
      </p>
    </div>
  </Section>
</Base>

<script>
  /**
   * Document viewer for the reference register.
   *
   * One dialog serves every reference. PDFs go in an <object> (native viewer,
   * no library); images in an <img>. Multi-page documents — the bachelor
   * supplement is five files — page with the arrows or the keyboard.
   *
   * Deep links work: /credentials/#r-2 opens reference 2 directly, which is what
   * makes a citation like [2] on another page actually land somewhere.
   */
  const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
  const viewer = document.getElementById('doc-viewer')!;
  const body = document.getElementById('doc-body')!;
  const titleEl = document.getElementById('doc-title')!;
  const numEl = document.getElementById('doc-num')!;
  const pager = document.getElementById('doc-pager')!;
  const openLink = document.getElementById('doc-open') as HTMLAnchorElement;
  const prev = document.getElementById('doc-prev')!;
  const next = document.getElementById('doc-next')!;

  let files: string[] = [];
  let page = 0;

  const isPdfFile = (f: string) => f.toLowerCase().endsWith('.pdf');

  function render() {
    const f = files[page];
    if (!f) return;
    const url = `${base}refs/${f}`;
    openLink.href = url;
    pager.textContent = files.length > 1 ? `${page + 1} / ${files.length}` : '';
    prev.classList.toggle('hidden', files.length < 2);
    next.classList.toggle('hidden', files.length < 2);
    body.innerHTML = isPdfFile(f)
      ? `<object data="${url}" type="application/pdf" class="w-full h-[76vh] rounded-lg">
           <p class="p-6 text-fg-dim text-[13px]">This browser will not display the PDF inline.
             <a href="${url}" target="_blank" rel="noopener" class="text-synapse">Open it in a new tab</a>.</p>
         </object>`
      : `<img src="${url}" alt="" class="max-w-full h-auto rounded-lg" />`;
  }

  function open(n: number) {
    const btn = document.querySelector<HTMLButtonElement>(`[data-ref="${n}"]`);
    if (!btn) return;
    files = (btn.dataset.files || '').split('|').filter(Boolean);
    page = 0;
    numEl.textContent = String(n);
    titleEl.textContent = btn.dataset.title || '';
    viewer.classList.remove('hidden');
    viewer.classList.add('flex');
    document.body.style.overflow = 'hidden';
    render();
  }

  function close() {
    viewer.classList.add('hidden');
    viewer.classList.remove('flex');
    body.innerHTML = '';           // stop a PDF plugin rendering behind the page
    document.body.style.overflow = '';
  }

  document.querySelectorAll<HTMLButtonElement>('[data-ref]').forEach((b) =>
    b.addEventListener('click', () => open(Number(b.dataset.ref))));

  document.getElementById('doc-close')!.addEventListener('click', close);
  document.getElementById('doc-backdrop')!.addEventListener('click', close);
  prev.addEventListener('click', () => { page = (page - 1 + files.length) % files.length; render(); });
  next.addEventListener('click', () => { page = (page + 1) % files.length; render(); });

  addEventListener('keydown', (e) => {
    if (viewer.classList.contains('hidden')) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft' && files.length > 1) { page = (page - 1 + files.length) % files.length; render(); }
    if (e.key === 'ArrowRight' && files.length > 1) { page = (page + 1) % files.length; render(); }
  });

  // A citation elsewhere links to #r-n; honour it on load and on hash change.
  const fromHash = () => {
    const m = location.hash.match(/^#r-(\d+)$/);
    if (m) open(Number(m[1]));
  };
  fromHash();
  addEventListener('hashchange', fromHash);
</script>

<style>
  .ref-num {
    display: inline-flex; align-items: center; justify-content: center;
    width: 30px; height: 30px; border-radius: 9px;
    font-size: 13.5px; font-weight: 700; font-variant-numeric: tabular-nums;
    color: var(--color-synapse);
    background: color-mix(in srgb, var(--color-neural) 16%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-neural) 38%, transparent);
  }
  .ref-row { cursor: pointer; transition: border-color .2s, transform .2s, box-shadow .2s; }
  .ref-row:hover { transform: translateY(-1px); }
</style>
