---
export type LinkState = 'live' | 'hosted' | 'gone' | 'none';

interface Props {
  title: string;
  issuer: string;
  when: string;
  detail?: string;
  href?: string;
  /** live   — external link, checked and working
   *  hosted — a copy served from this site, because the original needs a login
   *  gone   — the source is offline; the fact stands, the link does not
   *  none   — no link ever existed */
  state: LinkState;
}
const { title, issuer, when, detail, href, state } = Astro.props;

const badge = {
  live:   { text: 'source',    cls: 'text-synapse border-synapse/40' },
  hosted: { text: 'document',  cls: 'text-neural-text border-neural/40' },
  gone:   { text: 'link n/a',  cls: 'text-fg-ghost border-line' },
  none:   { text: '',          cls: '' },
}[state];
---
<div class="card p-4 flex flex-col gap-1.5">
  <div class="flex items-start justify-between gap-3">
    <b class="text-[14px] leading-snug">{title}</b>
    {badge.text && (
      <span class={`text-[10px] uppercase tracking-wider border rounded px-1.5 py-0.5 shrink-0 ${badge.cls}`}>
        {badge.text}
      </span>
    )}
  </div>
  <div class="text-[12px] text-fg-ghost">{issuer} · {when}</div>
  {detail && <div class="text-[13px] text-fg-dim" set:html={detail} />}
  {href && state !== 'gone' && (
    <a href={href} target="_blank" rel="noopener"
       class="text-[12.5px] mt-1 no-underline hover:underline">
      {state === 'hosted' ? 'View document →' : 'Open source →'}
    </a>
  )}
  {state === 'gone' && (
    <div class="text-[12px] text-fg-ghost italic mt-1">Original page offline; record held.</div>
  )}
</div>
