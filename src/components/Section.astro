---
interface Props {
  id?: string;
  title: string;
  lede?: string;
  /** Small right-aligned note — a count, a date, a status. */
  note?: string;
}
const { id, title, lede, note } = Astro.props;
---
<section id={id} class="relative py-12">
  <!-- Section divider as a lit filament: bright at the left, fading right. -->
  <span class="absolute bottom-0 left-0 right-0 h-px pointer-events-none"
        style="background: linear-gradient(90deg,
                 color-mix(in srgb, var(--color-neural) 55%, transparent) 0%,
                 color-mix(in srgb, var(--color-synapse) 28%, transparent) 30%,
                 var(--color-line) 70%,
                 transparent 100%);
               box-shadow: 0 0 12px -2px color-mix(in srgb, var(--color-neural) 45%, transparent)" />
  <div class="flex items-baseline justify-between gap-4 mb-3">
    <h2 class="section-title">{title}</h2>
    {note && <span class="text-[12px] text-fg-ghost tracking-wider uppercase shrink-0">{note}</span>}
  </div>
  {lede && <p class="lede mt-0 mb-6">{lede}</p>}
  <slot />
</section>
