---
interface Props {
  label: string;
  value: string | number;
  sub?: string;
  accent?: 'neural' | 'synapse' | 'forge' | 'plain';
  /** Columns to occupy at desktop width. Omit inside a uniform grid — the tile
   *  then takes one cell and the parent decides the layout. */
  span?: 1 | 2 | 3 | 6;
  /** Stagger the entrance so a row of tiles resolves left to right. */
  delay?: number;
}
const { label, value, sub, accent = 'plain', span, delay = 0 } = Astro.props;

// The lit-* classes carry both the colour and its glow.
const colour = {
  neural:  'lit-violet',
  synapse: 'lit-cyan',
  forge:   'lit-forge',
  plain:   'text-fg',
}[accent];

const rail = {
  neural:  'var(--color-neural)',
  synapse: 'var(--color-synapse)',
  forge:   'var(--color-forge)',
  plain:   'var(--color-line-lit)',
}[accent];

// No span given: occupy exactly one cell and let the parent grid decide.
const cols = span
  ? { 1: 'col-span-1 md:col-span-1', 2: 'col-span-2 md:col-span-2', 3: 'col-span-2 md:col-span-3', 6: 'col-span-2 md:col-span-6' }[span]
  : '';
---
<div
  class={`card group relative overflow-hidden p-5 ${cols}`}
  style={`animation: countIn .5s ease-out ${delay}ms both`}
>
  <!-- Lit rail down the left edge, in the tile's own accent. -->
  <span
    class="pointer-events-none absolute left-0 top-0 bottom-0 w-[2px]"
    style={`background: linear-gradient(180deg, transparent, ${rail}, transparent);
            box-shadow: 0 0 12px ${rail}; opacity: .55`}
  />

  <!-- A single scan pass on entry, then still. -->
  <span
    class="pointer-events-none absolute inset-x-0 top-0 h-[26px]"
    style={`background: linear-gradient(180deg, color-mix(in srgb, ${rail} 26%, transparent), transparent);
            animation: scanline 2.6s cubic-bezier(.4,0,.2,1) ${delay + 260}ms both`}
  />

  <!-- Sheen on hover: something passing underneath the glass. -->
  <span
    class="pointer-events-none absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
    style="background: linear-gradient(115deg, transparent 38%, color-mix(in srgb, var(--color-neural) 20%, transparent) 50%, transparent 62%); animation: sheen 1.2s ease-out"
  />

  <div class="relative text-[17px] tracking-[.14em] uppercase text-fg-ghost mb-2">{label}</div>
  <div class={`relative text-[36px] font-semibold leading-none tracking-tight ${colour}`}>{value}</div>
  {sub && <div class="relative text-[17px] text-fg-dim mt-2" set:html={sub} />}
  <slot />
</div>
