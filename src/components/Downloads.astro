---
/**
 * Download row for the hero.
 *
 * Three audiences, in the order they matter here:
 *   1. A model reading the whole pack — markdown, because that is what reads best.
 *   2. A person who wants the CV and a map of the rest.
 *   3. A system that still requires PDF.
 *
 * The framing is deliberate: markdown first, PDF as the legacy option, because a
 * hiring pipeline reads this with a model before a human sees it.
 */
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<div class="flex flex-wrap items-stretch gap-2.5 mb-7">
  <a href={`${base}downloads/malcek-full-pack.zip`} download
     class="dl-card dl-primary group flex flex-col no-underline px-4 py-3 rounded-xl">
    <span class="flex items-center gap-2 mb-0.5">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
           stroke-linecap="round" aria-hidden="true"><path d="M12 3v12M7 11l5 5 5-5M4 21h16"/></svg>
      <b class="text-[13.5px]">Full pack for your AI</b>
    </span>
    <span class="text-[11.5px] opacity-75">10 markdown files · papers, thesis, CV · with a README written for a model</span>
  </a>

  <a href={`${base}downloads/malcek-cv.zip`} download
     class="dl-card group flex flex-col no-underline px-4 py-3 rounded-xl">
    <span class="flex items-center gap-2 mb-0.5">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
           stroke-linecap="round" aria-hidden="true"><path d="M12 3v12M7 11l5 5 5-5M4 21h16"/></svg>
      <b class="text-[13.5px]">CV only</b>
    </span>
    <span class="text-[11.5px] opacity-75">markdown + a brief overview and the reference index</span>
  </a>

  <a href={`${base}downloads/cv.pdf`} download title="PDF — for systems that still require it"
     class="dl-card dl-legacy group flex items-center gap-2 no-underline px-3.5 py-3 rounded-xl">
    <svg width="15" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
         aria-hidden="true"><path d="M14 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8z"/><path d="M14 3v5h5"/></svg>
    <span class="text-[12.5px]">PDF</span>
  </a>
</div>
