---
/**
 * Hero and gallery for one project. Files live in public/shots/<slug>/.
 * hero.* is the title image. Every other image is a gallery shot, in name order.
 */
import fs from 'node:fs';
import path from 'node:path';
import Section from './Section.astro';

interface Props {
  slug: string;
  alt: string;
  /** Render only the hero, only the gallery, or both. */
  part?: 'hero' | 'gallery' | 'both';
}
const { slug, alt, part = 'both' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const dir = path.join(process.cwd(), 'public/shots', slug);
const files = fs.existsSync(dir)
  ? fs.readdirSync(dir).filter((f) => /\.(png|jpe?g|webp)$/i.test(f)).sort()
  : [];
const hero = files.find((f) => /^hero\./i.test(f));
const rest = files.filter((f) => f !== hero);
---
{part !== 'gallery' && (
  <Section id="hero" title="Screenshot" note="hero">
    {hero ? (
      <div class="card overflow-hidden">
        <img src={`${base}shots/${slug}/${hero}`} alt={alt} loading="lazy" class="w-full h-auto block" />
      </div>
    ) : (
      <div class="card p-6 text-fg-ghost">No hero image in public/shots/{slug}/</div>
    )}
  </Section>
)}
{part !== 'hero' && rest.length > 0 && (
  <Section id="more-shots" title="More screenshots" note={`${rest.length}`}>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {rest.map((f) => (
        <figure class="card overflow-hidden m-0">
          <img src={`${base}shots/${slug}/${f}`} alt={`${alt} — ${f}`} loading="lazy" class="w-full h-auto block" />
        </figure>
      ))}
    </div>
  </Section>
)}
