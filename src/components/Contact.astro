---
/**
 * Contact details, assembled in the browser rather than sitting in the HTML.
 *
 * Not security — anyone determined can read the bundle. It is enough to defeat
 * the crawlers that harvest `mailto:` and phone patterns out of static pages,
 * which is the actual threat to a public CV. The address is the town, not the
 * street: a hiring manager needs the timezone, not the doorstep.
 */

/** Split so neither the address nor the number appears intact in the source. */
const U = 'miso.malcek';
const D = ['gmail', 'com'];
const P = ['+421', '950', '200', '395'];
---
<div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-[13px]">
  <button type="button" data-contact="mail"
          data-u={U} data-d1={D[0]} data-d2={D[1]}
          class="contact-btn inline-flex items-center gap-2 text-fg-dim hover:text-fg transition-colors">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
         class="text-synapse shrink-0" aria-hidden="true">
      <path d="M4 4h16v16H4zM4 7l8 6 8-6" />
    </svg>
    <span data-slot>show email</span>
  </button>

  <button type="button" data-contact="tel"
          data-p1={P[0]} data-p2={P[1]} data-p3={P[2]} data-p4={P[3]}
          class="contact-btn inline-flex items-center gap-2 text-fg-dim hover:text-fg transition-colors">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
         class="text-synapse shrink-0" aria-hidden="true">
      <path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a1 1 0 01-1 1A16 16 0 014 5a1 1 0 011-1z" />
    </svg>
    <span data-slot>show phone</span>
  </button>

  <span class="inline-flex items-start sm:items-center gap-2 text-fg-dim flex-wrap">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
         class="text-synapse shrink-0" aria-hidden="true">
      <path d="M12 21s7-6.3 7-11a7 7 0 10-14 0c0 4.7 7 11 7 11z" /><circle cx="12" cy="10" r="2.5" />
    </svg>
    <span>Poprad, Slovakia<span class="text-fg-ghost text-[12.5px]"> · 10 min from the airport, 2 h to London</span></span>
  </span>
</div>

<script>
  // Reveal on click: the value is assembled here, so a scraper reading the HTML
  // finds fragments and a person finds a working link.
  document.querySelectorAll<HTMLButtonElement>('[data-contact]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const slot = btn.querySelector('[data-slot]')!;
      const d = btn.dataset;
      const value = d.contact === 'mail'
        ? `${d.u}@${d.d1}.${d.d2}`
        : [d.p1, d.p2, d.p3, d.p4].join(' ');
      const href = d.contact === 'mail' ? `mailto:${value}` : `tel:${value.replace(/\s/g, '')}`;

      const a = document.createElement('a');
      a.href = href;
      a.textContent = value;
      a.className = 'no-underline hover:underline text-fg';
      slot.replaceWith(a);
      btn.replaceWith(...btn.childNodes);   // drop the button, keep icon + link
    }, { once: true });
  });
</script>
