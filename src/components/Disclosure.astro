---
interface Props {
  summary: string;
  /** Right-aligned cost/《outcome》marker on the summary row. */
  tag?: string;
}
const { summary, tag } = Astro.props;
---
<details class="card mb-3 open:border-neural/35 group">
  <summary class="cursor-pointer px-5 py-4 text-[18px] flex items-center gap-3 list-none [&::-webkit-details-marker]:hidden">
    <span class="text-neural text-[23px] leading-none transition-transform duration-200 group-open:rotate-90">›</span>
    <span class="flex-1">{summary}</span>
    {tag && <span class="text-[17px] text-forge shrink-0">{tag}</span>}
  </summary>
  <div class="px-5 pb-5 pl-11 text-fg-dim text-[18px] [&>p]:mb-3 [&>p:last-child]:mb-0">
    <slot />
  </div>
</details>
