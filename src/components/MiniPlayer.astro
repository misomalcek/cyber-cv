---
/**
 * Three tracks, one line, no library — and it keeps playing across navigations.
 *
 * How the continuity works: the `<audio>` element is created once and parked on
 * `window`, not in the DOM. Astro's ClientRouter swaps the document body on a
 * soft navigation, so anything inside it would be destroyed; a JS-owned Audio
 * object survives because nothing in the page holds it. Each page then renders
 * its own controls and re-attaches them on `astro:page-load`, reading the
 * current state back out rather than resetting it.
 *
 * `compact` drops the source credit and narrows the title track, for the
 * subpage variant that sits on the back-link line.
 */
interface Props { compact?: boolean }
const { compact = false } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const tracks = [
  { file: 'alterans-awake.mp3',  title: 'Alterans Awake' },
  { file: 'neuro-wars.mp3',      title: 'Neuro Wars' },
  { file: 'cyber-junglist.mp3',  title: 'Cyber Junglist' },
];
---
<div class:list={['mini-player inline-flex items-center gap-2 rounded-full pl-2 pr-3 py-1 border border-line', { compact }]}
     data-player
     data-tracks={JSON.stringify(tracks.map((t) => ({ ...t, src: `${base}music/${t.file}` })))}>

  <button type="button" data-prev aria-label="Previous track" class="mp-btn">
    <svg width="11" height="11" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
      <path d="M11 1v10L4 6l7-5zM3 1h1.4v10H3z" />
    </svg>
  </button>

  <button type="button" data-toggle aria-label="Play" class="mp-btn mp-play">
    <svg data-icon-play width="12" height="12" viewBox="0 0 10 12" fill="currentColor" aria-hidden="true">
      <path d="M0 0.5L10 6L0 11.5V0.5Z" />
    </svg>
    <svg data-icon-pause width="12" height="12" viewBox="0 0 10 12" fill="currentColor"
         aria-hidden="true" style="display:none">
      <path d="M0 0h3.2v12H0zM6.8 0H10v12H6.8z" />
    </svg>
  </button>

  <button type="button" data-next aria-label="Next track" class="mp-btn">
    <svg width="11" height="11" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
      <path d="M1 1v10l7-5-7-5zM9 1h1.4v10H9z" />
    </svg>
  </button>

  {!compact && (
    <span class="mp-track" aria-live="polite">
      {/* Two copies of the label, end to end: the marquee translates by exactly
          one copy's width and loops, so the text runs continuously instead of
          snapping back. The second copy is hidden from assistive tech. */}
      <span class="mp-belt" data-belt>
        <span data-title class="mp-title"></span>
        <span data-title-clone class="mp-title" aria-hidden="true"></span>
      </span>
    </span>
  )}

  {!compact && (
    <a href="https://suno.com/@neonfire" target="_blank" rel="noopener" class="mp-src">music by SUNO</a>
  )}
</div>

<style>
  .mini-player {
    background: color-mix(in srgb, var(--color-neural) 8%, transparent);
    max-width: 100%;
  }
  .mp-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 26px; height: 26px; border-radius: 50%; flex-shrink: 0;
    color: var(--color-fg-dim); background: none; border: 0; cursor: pointer;
    transition: color .18s, background .18s;
  }
  .mp-btn:hover { color: var(--color-synapse); background: color-mix(in srgb, var(--color-synapse) 14%, transparent); }
  .mp-play { color: var(--color-synapse); }
  .mp-play[data-on] { box-shadow: 0 0 12px -2px color-mix(in srgb, var(--color-synapse) 70%, transparent); }

  .mp-track {
    width: 210px; overflow: hidden; white-space: nowrap; flex-shrink: 0;
    margin-left: 4px;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10px, #000 calc(100% - 10px), transparent);
    mask-image: linear-gradient(90deg, transparent, #000 10px, #000 calc(100% - 10px), transparent);
  }
  /* The belt holds both copies; animating it (not the label) is what makes the
     loop seamless — at -50% the second copy sits exactly where the first began. */
  .mp-belt { display: inline-flex; will-change: transform; }
  .mp-belt[data-run] { animation: mp-marquee var(--mp-dur, 14s) linear infinite; }
  .mp-title {
    font-size: 17px; color: var(--color-fg); padding-right: 2.5rem;
  }
  @keyframes mp-marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  .mp-src {
    font-size: 17px; margin-left: 2px; color: var(--color-fg-ghost); text-decoration: none;
    white-space: nowrap; flex-shrink: 0; transition: color .18s;
  }
  .mp-src:hover { color: var(--color-synapse); }

  .mini-player.compact { padding-right: 0.5rem; }

  @media (max-width: 560px) {
    .mp-track { width: 128px; }
    .mp-src { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mp-belt[data-run] { animation: none; }
  }
</style>

<script>
  type Track = { title: string; src: string };

  interface PlayerState { audio: HTMLAudioElement; i: number; tracks: Track[] }
  declare global { interface Window { __cvPlayer?: PlayerState } }

  /**
   * One Audio object for the whole site, created lazily and kept on `window` so
   * a soft navigation cannot collect it. Nothing in the DOM references it.
   */
  function getPlayer(tracks: Track[]): PlayerState {
    if (!window.__cvPlayer) {
      const audio = new Audio();
      audio.preload = 'none';
      window.__cvPlayer = { audio, i: 0, tracks };
      audio.addEventListener('ended', () => {
        const st = window.__cvPlayer!;
        st.i = (st.i + 1) % st.tracks.length;
        audio.src = st.tracks[st.i].src;
        audio.play().catch(() => {});
        document.dispatchEvent(new CustomEvent('cv:track'));
      });
    }
    return window.__cvPlayer;
  }

  function mount() {
    const root = document.querySelector<HTMLElement>('[data-player]');
    if (!root) return;

    const tracks: Track[] = JSON.parse(root.dataset.tracks || '[]');
    const st = getPlayer(tracks);
    st.tracks = tracks;

    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const iPlay = root.querySelector<HTMLElement>('[data-icon-play]')!;
    const iPause = root.querySelector<HTMLElement>('[data-icon-pause]')!;
    const titleEl = root.querySelector<HTMLElement>('[data-title]');
    const cloneEl = root.querySelector<HTMLElement>('[data-title-clone]');
    const belt = root.querySelector<HTMLElement>('[data-belt]');
    const trackBox = root.querySelector<HTMLElement>('.mp-track');

    const label = (n: number) => `${st.tracks[n].title} — neonfire`;

    /* Duration scales with width so the scroll speed stays constant regardless
       of title length; measured after paint, since a label laid out this frame
       still reports zero. */
    const paint = () => {
      if (!titleEl || !cloneEl || !belt || !trackBox) return;
      titleEl.textContent = label(st.i);
      cloneEl.textContent = label(st.i);
      belt.removeAttribute('data-run');
      requestAnimationFrame(() => {
        const one = titleEl.scrollWidth;
        if (one > 0) {
          belt.style.setProperty('--mp-dur', `${Math.max(9, one / 26)}s`);
          belt.setAttribute('data-run', '');
        }
      });
    };

    const setPlaying = (on: boolean) => {
      iPlay.style.display = on ? 'none' : '';
      iPause.style.display = on ? '' : 'none';
      toggle.setAttribute('aria-label', on ? 'Pause' : 'Play');
      on ? toggle.setAttribute('data-on', '') : toggle.removeAttribute('data-on');
    };

    const load = (n: number, play: boolean) => {
      st.i = (n + st.tracks.length) % st.tracks.length;
      st.audio.src = st.tracks[st.i].src;
      paint();
      if (play) st.audio.play().catch(() => setPlaying(false));
    };

    toggle.onclick = () => {
      if (!st.audio.src) load(0, true);
      else if (st.audio.paused) st.audio.play().catch(() => setPlaying(false));
      else st.audio.pause();
    };
    root.querySelector<HTMLElement>('[data-prev]')!.onclick = () => load(st.i - 1, !st.audio.paused);
    root.querySelector<HTMLElement>('[data-next]')!.onclick = () => load(st.i + 1, !st.audio.paused);

    /* Reflect state rather than reset it: on a fresh page the controls must show
       what the surviving Audio object is actually doing. */
    const sync = () => setPlaying(!st.audio.paused && !st.audio.ended);
    st.audio.onplay = sync;
    st.audio.onpause = sync;
    document.addEventListener('cv:track', paint);

    paint();
    sync();
  }

  mount();
  document.addEventListener('astro:page-load', mount);
</script>
