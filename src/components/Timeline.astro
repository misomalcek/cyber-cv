---
export interface Entry {
  when: string;
  what: string;
  where?: string;
  body: string;
  /** Bullet points under the prose — measurable outcomes, not duties. */
  points?: string[];
  tags?: string[];
  /** Marks the row that changed direction. */
  pivot?: boolean;
}
interface Props { entries: Entry[] }
const { entries } = Astro.props;
---
<div class="relative">
  {entries.map((e) => (
    <div class="grid md:grid-cols-[140px_1fr] gap-2 md:gap-6 py-5 border-t border-line first:border-t-0">
      <div class="text-[12.5px] text-fg-ghost md:pt-1 flex items-center md:items-start gap-2">
        {e.pivot && (
          <span class="inline-block w-[6px] h-[6px] rounded-full bg-forge shrink-0"
                style="animation: pulse 2.4s ease-in-out infinite" />
        )}
        <span>{e.when}</span>
      </div>
      <div>
        <b class="block text-[15px] mb-0.5">{e.what}</b>
        {e.where && <div class="text-[12.5px] text-fg-ghost mb-2">{e.where}</div>}
        <p class="text-fg-dim m-0 text-[14px]" set:html={e.body} />
        {e.points && (
          <ul class="mt-3 mb-0 pl-0 list-none flex flex-col gap-1.5">
            {e.points.map((p) => (
              <li class="text-[13.5px] text-fg-dim pl-4 relative">
                <span class="absolute left-0 top-[9px] w-[5px] h-[1px] bg-neural" />
                <span set:html={p} />
              </li>
            ))}
          </ul>
        )}
        {e.tags && (
          <div class="flex flex-wrap gap-1.5 mt-3">
            {e.tags.map((t) => <span class="chip">{t}</span>)}
          </div>
        )}
      </div>
    </div>
  ))}
</div>
