---
/**
 * Per-document download pair. Markdown first — a model reads it better and a
 * person can read it anywhere — with PDF beside it for anything that needs one.
 */
interface Props { slug: string; label?: string; }
const { slug, label } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<span class="inline-flex items-center gap-1.5 shrink-0">
  {label && <span class="text-[11px] text-fg-ghost mr-0.5">{label}</span>}
  <a href={`${base}downloads/${slug}.md`} download
     class="doc-dl text-[11.5px] no-underline px-2 py-0.5 rounded">md</a>
  <a href={`${base}downloads/${slug}.pdf`} download
     class="doc-dl text-[11.5px] no-underline px-2 py-0.5 rounded">pdf</a>
</span>
