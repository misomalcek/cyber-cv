---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Shown as a back-link on subpages; omitted on the index. */
  back?: { href: string; label: string };
}
const { title, description, back } = Astro.props;

const nav = [
  { href: '/#work',        label: 'Systems' },
  { href: '/#hive',        label: 'The hive' },
  { href: '/#results',     label: 'Results' },
  { href: '/#apparatus',   label: 'The apparatus' },
  { href: '/#wrong',       label: 'What went wrong' },
  { href: '/#research',    label: 'Research' },
  { href: '/#code',        label: 'Code' },
  { href: '/#track',       label: 'Career' },
  { href: '/credentials/', label: 'Credentials' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="profile" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
  <meta name="twitter:card" content="summary" />

  {/* The page is a structured professional profile, so it may as well be
      structured. Kept minimal and factual — no claims here that are not on
      the page itself. */}
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    mainEntity: {
      '@type': 'Person',
      name: 'Michal Malček',
      email: 'miso.malcek@gmail.com',
      jobTitle: 'AI Engineer',
      description: 'AI engineer. One production system delivered and handed over, one running daily — built and measured on a single local machine.',
      knowsLanguage: ['sk', 'cs', 'en', 'de'],
      alumniOf: [
        { '@type': 'CollegeOrUniversity', name: 'University of Economics, Prague' },
        { '@type': 'EducationalOrganization', name: 'CEMS — The Global Alliance in Management Education' },
      ],
      knowsAbout: [
        'AI engineering', 'Retrieval-augmented generation', 'Knowledge graphs',
        'Local model inference', 'TypeScript', 'PostgreSQL', 'Vector databases',
      ],
    },
  })} />
</head>
<body class="grid-field">
  <div class="relative z-[1] mx-auto max-w-[940px] px-6 pb-24">
    {back && (
      <a href={back.href}
         class="inline-block mt-8 text-[13px] text-fg-ghost no-underline hover:text-synapse transition-colors">
        ← {back.label}
      </a>
    )}

    <slot />

    <footer class="pt-10 pb-4 mt-4 border-t border-line text-[12.5px] text-fg-ghost">
      <nav class="flex flex-wrap gap-x-4 gap-y-2 mb-5">
        {nav.map((n) => (
          <a href={n.href} class="text-fg-ghost no-underline hover:text-synapse transition-colors">{n.label}</a>
        ))}
      </nav>
      <p class="m-0">
        Built with the same design system as Factorium · every number here is read from a
        store, not typed in · <a href="mailto:miso.malcek@gmail.com">miso.malcek@gmail.com</a>
      </p>
    </footer>
  </div>
</body>
</html>
