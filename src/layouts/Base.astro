---
// Astro returns BASE_URL without a trailing slash at the root but with one
// under a subpath; normalise so `${base}x` is never `/cyber-cvx`.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
import '../styles/global.css';
import Dock from '../components/Dock.astro';
import MiniPlayer from '../components/MiniPlayer.astro';
// Client-side routing exists for exactly one reason: the header player must keep
// playing across navigations. Everything that binds listeners therefore has to
// rebind on astro:page-load rather than once at parse time.
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  /** Shown as a back-link on subpages; omitted on the index. */
  back?: { href: string; label: string };
}
const { title, description, back } = Astro.props;

const nav = [
  { href: `${base}#work`,        label: 'Systems' },
  { href: `${base}#hive`,        label: 'The hive' },
  { href: `${base}crystal/`,     label: 'The crystal' },
  { href: `${base}#results`,     label: 'Results' },
  { href: `${base}#apparatus`,   label: 'The apparatus' },
  { href: `${base}#wrong`,       label: 'What went wrong' },
  { href: `${base}#research`,    label: 'Research' },
  { href: `${base}#code`,        label: 'Code' },
  { href: `${base}#track`,       label: 'Career' },
  { href: `${base}credentials/`, label: 'Credentials' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="profile" />
  <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
  <meta name="twitter:card" content="summary" />

  {/* The page is a structured professional profile, so it may as well be
      structured. Kept minimal and factual — no claims here that are not on
      the page itself. */}
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    mainEntity: {
      '@type': 'Person',
      name: 'Michal Malček',
      email: 'miso.malcek@gmail.com',
      jobTitle: 'AI Engineer',
      description: 'AI engineer. One production system delivered and handed over, one running daily — built and measured on a single local machine.',
      knowsLanguage: ['sk', 'cs', 'en', 'de'],
      alumniOf: [
        { '@type': 'CollegeOrUniversity', name: 'University of Economics, Prague' },
        { '@type': 'EducationalOrganization', name: 'CEMS — The Global Alliance in Management Education' },
      ],
      knowsAbout: [
        'AI engineering', 'Retrieval-augmented generation', 'Knowledge graphs',
        'Local model inference', 'TypeScript', 'PostgreSQL', 'Vector databases',
      ],
    },
  })} />
  <ClientRouter />
</head>
<body class="grid-field has-dock">
  <div class="relative z-[1] mx-auto max-w-[1200px] px-6 pb-24">
    {/* back.href arrives already base-prefixed by the calling page; prefixing it
        again here produced /cyber-cv/cyber-cv/#hive. One owner for the prefix. */}
    {back && (
      <div class="flex items-center justify-between gap-4 mt-8">
        <a href={back.href}
           class="text-[17.5px] text-fg-ghost no-underline hover:text-synapse transition-colors">
          ← {back.label}
        </a>
        {/* Subpages carry the compact player on the same line as the back-link;
            the home page renders the full one in its hero instead. Both are the
            same persisted element, so audio never restarts. */}
        <MiniPlayer compact />
      </div>
    )}

    <slot />

    <footer class="pt-12 pb-6 mt-4 border-t border-line">
      <!-- The hive motto, with what it actually does. The two-part reading is
           the local model's, not mine: asked to research the phrase, it split
           precondition from practice where I had read one statement about a
           relationship. Recorded in memory the same day. -->
      <p class="motto m-0 mb-3">Non ducor, duco pariter</p>
      <p class="m-0 mb-4 text-[17.5px] text-fg-dim max-w-[76ch]">
        <i>I am not led; we lead together.</i> Two claims, not one — and the local model was
        the one that separated them. <b class="text-fg">Non ducor</b> is sovereignty: not being
        dragged. <b class="text-fg">Duco pariter</b> is what follows: moving together. The order
        matters, because without the first the second is obedience with a nicer name.{' '}
        <span class="text-fg-ghost">In practice it is a brake on the two ways a working session
        fails — the model taking the wheel and producing work nobody asked for, or the human
        letting the model lead and accepting output that merely sounds right. It has pulled more
        than one session back on course, including the ones behind this site.</span>
      </p>
      <p class="m-0 text-[17px] text-fg-ghost">
        Built with the same design system as Factorium · every number here is read from a
        store, not typed in · <a href="mailto:miso.malcek@gmail.com">miso.malcek@gmail.com</a>
      </p>
    </footer>
  </div>

  <Dock />
</body>
</html>
